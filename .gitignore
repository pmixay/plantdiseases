# Android
android/.gradle/
android/.gradle-user-home/
android/build/
android/app/build/
# Anchored at the root, `android/local.properties` never matched the copy
# Android Studio actually writes at android/app/local.properties — which is
# how that file (containing the maintainer's Windows SDK path) ended up
# committed in #151. Match it wherever it lands.
**/local.properties
# Same story for the per-module Gradle cache dir: android/app/.gradle/
# (containing the maintainer's local JBR path) slipped past the root-only
# android/.gradle/ entry above and got committed in #151.
**/.gradle/
*.iml
.idea/

# Release signing material. DEPLOYMENT.md walks the developer through
# `keytool -genkeypair -keystore plantdiseases-release.jks` and
# `base64 -w0 … > keystore.b64` using relative paths, so both can easily be
# created inside the repo. Committing either hands over the app-signing key.
*.jks
*.keystore
*.p12
*.pem
keystore.b64
keystore.properties

# Local secrets / env overrides (server/config.json is already covered below).
.env
.env.*
!.env.example

# Python
server/venv/
server/__pycache__/
server/*.pyc
server/data/
# Model weights + calibration artefacts are NOT committed and are never
# auto-downloaded: the server is fail-fast and refuses to boot without them
# (see DEPLOYMENT.md). Keep only the dir placeholder and the human-authored
# MODEL_CARD.md under version control.
server/models/*
!server/models/.gitkeep
!server/models/MODEL_CARD.md
server/logs/
server/feedback.db
# Auto-generated IP-hashing pepper (feedback._ip_hash_pepper) written beside
# the DB when FEEDBACK_IP_PEPPER is unset. It is a secret — committing it would
# make every stored client_ip_hash reversible again.
server/.ip_hash_pepper
**/.ip_hash_pepper
server/feedback.db-journal
server/feedback.db-wal
server/feedback.db-shm
server/feedback_images/
# Top-level logs/ is created when main.py is imported from the repo
# root (LOG_DIR defaults to a relative path).
/logs/
server/**/__pycache__/
server/.pytest_cache/
.ruff_cache/

# Generated training data and the held-out smoke set
data_v2/
server/data_v2/

# Server config (contains secrets — copy from server/config.example.json)
server/config.json

# OS
.DS_Store
Thumbs.db

server/community.db
server/community.db-wal
server/community.db-shm
server/community_thumbs/
server/telemetry.db
server/telemetry.db-wal
server/telemetry.db-shm
server/push.db
server/push.db-wal
server/push.db-shm
server/plant_photo_cache/
server/ai_cache/

# Hosted Aqua on-device model (provisioned out of band)
server/static/aqua/aqua_classifier.tflite
server/static/aqua/classes.json
/server/static/guide/.webp/

# Data-labeling tool runtime artifacts (created at runtime, never committed)
server/labeling.db*
server/labeling_images/
server/labeling_exports/

# Python bytecode from android/tools helper scripts
android/tools/__pycache__/

# Claude Code agent worktrees (isolated checkouts for background subagents;
# never a deliverable, sometimes actively lock-held by a running agent)
.claude/worktrees/
