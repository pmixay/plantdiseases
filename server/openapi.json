              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/community/nearby": {
      "get": {
        "summary": "Community Scan Nearby",
        "description": "List the most recent community-shared scans within ``country``.\n\n``region`` narrows the result set to a sub-country locality\n(city / admin area) when supplied. ``species`` (scientific name,\nexact match) narrows further so the carousel only shows scans of\nthe same plant — without it, \"Ficus elastica with leaf spot\"\nappears next to \"Monstera with leaf spot\" and conflates two\ndifferent care routines.\n\nFall-through ordering inside ``nearby_scans`` is most-specific\nfirst: same disease+species+region → same disease+species → …\n→ same country (any disease). The carousel always fills up to\n``limit`` so a thin local bucket still surfaces something.",
        "operationId": "community_scan_nearby_api_community_nearby_get",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          },
          {
            "name": "disease",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Disease"
            }
          },
          {
            "name": "species",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Species"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "user_pseudo_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User Pseudo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/community/thumb/{filename}": {
      "get": {
        "summary": "Community Scan Thumb",
        "description": "Serve a community thumbnail by filename.\n\nThe corpus only ever stores filenames that ``community._save_thumbnail``\nminted, but we still hard-guard against path traversal: any\nfilename containing ``/`` or ``..`` is refused outright. Missing\nfiles return 404 instead of 500.",
        "operationId": "community_scan_thumb_api_community_thumb__filename__get",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          }
        ],
        "responses": {
