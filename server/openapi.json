      "delete": {
        "summary": "Community Scan Delete User",
        "description": "Erase all rows + thumbnails attributed to one install. Used by\nthe Android \"delete my contributions\" affordance.",
        "operationId": "community_scan_delete_user_api_community_user__user_pseudo_id__delete",
        "parameters": [
