      "CarePlanRequest": {
        "properties": {
          "disease": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Disease"
          },
          "species": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Species"
          },
          "light": {
            "type": "string",
            "maxLength": 32,
            "title": "Light",
            "default": "bright_indirect"
          },
          "locale": {
            "type": "string",
            "maxLength": 8,
            "title": "Locale",
            "default": "en"
          },
          "season": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16
              },
              {
                "type": "null"
              }
            ],
            "title": "Season"
          }
        },
        "type": "object",
        "required": [
          "disease"
        ],
        "title": "CarePlanRequest"
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "locale": {
            "type": "string",
            "maxLength": 8,
            "title": "Locale",
            "default": "en"
          },
          "diagnosis": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagnosis"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "FeedbackRequest": {
        "properties": {
          "scan_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Scan Id"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "corrected_class": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected Class"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
