                }
              }
            }
          }
        }
      }
    },
    "/api/care-plan": {
      "post": {
        "summary": "Care Plan Endpoint",
        "description": "Build a watering / fertilising / humidity schedule for a plant.\n\nAlways returns a usable rules-based plan; when an OpenRouter key\nis configured the response also includes a Markdown ``summary_md``\npolished by the LLM. Disease must be one of the known classifier\nclasses (``unknown`` is normalised to a generic monitoring plan).",
        "operationId": "care_plan_endpoint_api_care_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CarePlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/progression": {
      "post": {
        "summary": "Progression Endpoint",
        "description": "Disease-progression analysis. Returns a 5-point severity\nsparkline + a trend slope across the supplied history (oldest\nfirst). An empty list is allowed and yields a zero-padded\nbaseline so the client can render an \"awaiting data\" state\nwithout special-casing.",
        "operationId": "progression_endpoint_api_progression_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProgressionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "summary": "Feedback Endpoint",
        "description": "Capture a thumbs-up / thumbs-down on a diagnosis, with full\ndiagnostic + client context.\n\nAppend-only — there is no update / delete path. The 1 req/s per-IP\nrate limit from the global middleware applies; the endpoint\nadditionally caps ``note`` length via the pydantic model so a\nmalicious client can't bloat the SQLite file with megabytes of\ntext.\n\nThe raw client IP is hashed (peppered SHA-256) before persistence\nso we never store PII at rest. The hash is stable across a single\ndeployment, which is enough for abuse-rate detection.",
        "operationId": "feedback_endpoint_api_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback/image": {
      "post": {
        "summary": "Feedback Image Upload",
        "description": "Persist the original image bytes for a negative-feedback row.\n\nCalled by the Android client immediately after a successful\n``correct=false`` ``/api/feedback`` submission. The image is\nwritten to ``FEEDBACK_IMG_DIR`` keyed by SHA-256 of the bytes,\nand the most recent feedback row for ``scan_id`` is updated\nin-place with ``image_path``. Same per-IP rate limit and\nscan-id-was-issued gate as ``/api/feedback`` so a hostile\nclient can't spray arbitrary bytes at the corpus.\n\nPrivacy note: this endpoint reverses the historical \"we never\nstore the photo\" promise, but only for ``correct=false`` rows\nwhere the training value is highest. The Android feedback sheet\ndiscloses this in its copy; if the user wants their image\npurged they can use the existing community delete-for-user path\n(which doesn't currently sweep this directory; a separate\ncleanup endpoint is owed but out of scope here).",
        "operationId": "feedback_image_upload_api_feedback_image_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_feedback_image_upload_api_feedback_image_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/community/scan": {
      "post": {
        "summary": "Community Scan Upload",
        "description": "Append one community-shared scan to the corpus.\n\nHierarchy: ``country`` is the canonical top bucket (required),\n``region`` is the optional sub-country locality. The image is\noptional — when omitted we still store the row, just without a\nthumbnail.",
        "operationId": "community_scan_upload_api_community_scan_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_community_scan_upload_api_community_scan_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
