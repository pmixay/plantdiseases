    "/api/analyze": {
      "post": {
        "summary": "Analyze Image",
        "description": "Analyse a plant image for diseases (two-stage pipeline).\n\nAccepts JPEG, PNG, WebP, or BMP images up to 10 MB.\nReturns bilingual (EN/RU) disease diagnosis with treatment advice,\ndetected region (with severity score) and the top-k class\nprobabilities. ``locale`` (default \"en\") is forwarded to PlantNet\nso the species ``common_name`` is localised in the response.",
        "operationId": "analyze_image_api_analyze_post",
        "parameters": [
          {
            "name": "species",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "title": "Species"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "default": "en",
              "title": "Locale"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_image_api_analyze_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/identify": {
      "post": {
        "summary": "Identify Endpoint",
        "description": "PlantNet-backed plant species identification.\n\nReturns up to 5 candidate species with confidence scores. When the\nPlantNet API key is missing we still respond 200 OK with\n``available: false`` so the client can render a graceful state\ninstead of an error toast. Cached server-side by SHA-256(image) +\norgan + locale to keep the daily PlantNet quota intact.\n\n``locale`` is forwarded to PlantNet's ``lang`` query param so the\ncommon names come back localised (e.g. \"Каучуковое дерево\" on\nru-RU instead of \"Rubber tree\").",
        "operationId": "identify_endpoint_api_identify_post",
        "parameters": [
          {
            "name": "organ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "leaf",
              "title": "Organ"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en",
              "title": "Locale"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_identify_endpoint_api_identify_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Chat Endpoint",
        "description": "AI Plant Doctor — OpenRouter chat completion (default model\n``openai/gpt-oss-120b``).\n\nPer-session turn + token caps prevent budget overrun. Per-IP rate\nlimiting from the global middleware still applies.",
        "operationId": "chat_endpoint_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
