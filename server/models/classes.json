{
  "_comment": "PlantVision 2.1 — placeholder. The notebook (server/train_notebook.ipynb) overwrites this file in §6 with the real values after training. Disease macro-F1 on val_realworld is the primary metric.",
  "model_version": "2.1",
  "class_names": [
    "bacterial_leaf_spot",
    "gray_mold_botrytis",
    "healthy",
    "leaf_spot_fungal",
    "not_a_plant",
    "powdery_mildew",
    "viral_disease"
  ],
  "detector_classes": [
    "plant_leaf"
  ],
  "training": {
    "img_size": 256,
    "batch_size": 96,
    "loss": "logit_adjustment_ce",
    "logit_adjustment_tau": 0.7,
    "label_smoothing": 0.05,
    "use_weighted_sampler": false,
    "optimizer": "AdamW",
    "weight_decay": 1e-4,
    "lr_schedule": "cosine + warmup",
    "precision": "bf16-mixed",
    "primary_metric": "val_realworld_disease_macro_f1",
    "primary_val_set": "data_v2/classification/val/realworld",
    "isolated_val_slice": "data_v2/classification/val/plantvillage_studio"
  },
  "distillation": {
    "teacher": "tf_efficientnetv2_s.in21k_ft_in1k",
    "student": "mobilenet_v3_large",
    "loss": "alpha*KD + (1-alpha)*CE_LA",
    "alpha": 0.5,
    "tau": 4.0,
    "ema_decay": 0.999,
    "epochs": 10
  },
  "ood": {
    "score": "max_logit",
    "max_logit_floor": 4.0,
    "_score_note": "MaxLogit (Hendrycks 2019). Robust under temperature scaling and label smoothing where MSP fails."
  }
}
