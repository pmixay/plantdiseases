root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
# Line length is intentionally not enforced by ktlint here; the codebase wraps
# by hand and many doc comments run long.
max_line_length = off
# Rules relaxed to match the existing hand-formatted style. Re-enable
# incrementally (run `./gradlew ktlintFormat` first) as the tree is cleaned up.
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_import-ordering = disabled
ktlint_standard_filename = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_comment-wrapping = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled

[*.{yml,yaml,json,xml}]
indent_size = 2
