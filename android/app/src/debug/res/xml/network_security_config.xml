<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY config. Resource merging makes this file replace
    app/src/main/res/xml/network_security_config.xml for the debug variant, so
    nothing here can reach a release APK.

    Production transport stays HTTPS-only (base-config below is unchanged from
    the release file). Cleartext is permitted only for the local development
    hosts, so a developer can point a debug build at the emulator host:

        ./gradlew :app:assembleDebug \
          -PAPP_API_BASE_URL=http://10.0.2.2:18000/ \
          -PACCOUNT_API_BASE_URL=http://10.0.2.2:18001/

    Android does not support CIDR ranges here — add a specific LAN IP below if
    you serve from one during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
