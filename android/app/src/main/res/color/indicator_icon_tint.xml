<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding page-indicator icon tint: white on the filled (selected)
     primary circle, primary on the light unselected circle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/on_primary" />
    <item android:color="@color/primary" />
</selector>
