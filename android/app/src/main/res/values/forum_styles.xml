<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Community forum: rounded photos, small pill badges and meta text. -->
    <style name="ShapeAppearance.App.ForumPhoto" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Forum.Meta" parent="">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/forum_text_meta</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Forum.Badge" parent="">
        <item name="android:background">@drawable/bg_forum_badge</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Forum.Action" parent="">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="drawableTint">@color/on_surface_secondary</item>
    </style>

    <!-- Feed card: a soft tinted surface with a light stroke; content is
         padded by the card's inner layout so photos can sit edge to edge. -->
    <style name="App.ForumCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container_low</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/forum_card_stroke</item>
    </style>

    <!-- Monogram avatar; tint the background per nickname. -->
    <style name="Forum.Avatar" parent="">
        <item name="android:background">@drawable/bg_forum_avatar</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/forum_on_photo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Status pill (Solved, Urgent, …): colour and icon are set in code. -->
    <!-- A member's profile photo laid over the monogram; shown only when the
         author has one (ForumViews.bindAvatar). -->
    <style name="Forum.AvatarPhoto" parent="">
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:visibility">gone</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Avatar</item>
    </style>

    <style name="Forum.Pill" parent="Forum.Badge">
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="TextAppearance.App.Forum.CardTitle" parent="TextAppearance.App.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="TextAppearance.App.Forum.ThreadTitle" parent="TextAppearance.App.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Label drawn over a photo. -->
    <style name="Forum.PhotoLabel" parent="">
        <item name="android:drawablePadding">5dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A number and its label on a hero card (achievements screen). -->
    <style name="Forum.HeroStat" parent="">
        <item name="android:background">@drawable/bg_forum_hero_stat</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/on_hero</item>
        <item name="android:textSize">@dimen/forum_text_meta</item>
    </style>

    <!-- A tappable "Label: value" row that opens a picker (composer). -->
    <style name="Forum.PickerRow" parent="">
        <item name="android:background">@drawable/bg_forum_picker_row</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="drawableTint">@color/primary</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_right</item>
    </style>


    <!-- Grow-from-corner window animation for the Community menu. -->
    <style name="Forum.MenuAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/forum_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/forum_menu_exit</item>
    </style>
</resources>
