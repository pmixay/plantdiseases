<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Community forum: rounded photos, small pill badges and meta text. -->
    <style name="ShapeAppearance.App.ForumPhoto" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Forum.Meta">
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Forum.Badge">
        <item name="android:background">@drawable/bg_forum_badge</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Forum.Action">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="drawableTint">@color/on_surface_secondary</item>
    </style>

</resources>
