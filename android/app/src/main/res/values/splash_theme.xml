<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlantDiseases.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <!-- The real logotype (same artwork as the launcher icon), pre-padded
             into the splash safe zone so the Android-12 circle mask shows it
             complete instead of chopping the full-bleed icon. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.PlantDiseases</item>
    </style>
</resources>
