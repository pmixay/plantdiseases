    <!-- Pre-scan tips sheet (replaces auto-capture). -->
    <string name="scan_tips_title">Before you scan</string>
    <string name="scan_tips_subtitle">Three quick framing rules — they fix almost every "weird diagnosis".</string>
    <string name="scan_tips_continue">Got it — let\'s scan</string>
    <string name="scan_tip_distance_title">Get the distance right</string>
    <string name="scan_tip_distance_body">Too close: only a tiny patch is in frame. Too far: the leaf is a thumbnail. Aim so one leaf fills most of the frame.</string>
    <string name="scan_tip_focus_title">Hold steady, wait for focus</string>
    <string name="scan_tip_focus_body">Tap the leaf to lock autofocus. Avoid back-lit shots — the leaf should not be a dark silhouette against a bright window.</string>
    <string name="scan_tip_single_title">One species per frame</string>
    <string name="scan_tip_single_body">Mixing two plants in one photo confuses both the classifier and the species detector. Crop or step back to isolate a single plant.</string>
