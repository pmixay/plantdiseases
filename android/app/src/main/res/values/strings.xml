        <item quantity="one">%1$d plant watched with %2$d scans</item>
        <item quantity="other">%1$d plants watched with %2$d scans</item>
    </plurals>
    <plurals name="scan_count">
        <item quantity="one">%d scan</item>
        <item quantity="other">%d scans</item>
    </plurals>

