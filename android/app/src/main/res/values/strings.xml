    <!-- Pipeline warnings -->
    <string name="warning_very_low_confidence_title">Very low confidence</string>
    <string name="warning_very_low_confidence">The model isn\'t confident in this verdict — please retake the photo with the leaf filling most of the frame, in good even light, and on a plain background.</string>
    <string name="warning_uncertain_healthy_title">Could be disease</string>
    <string name="warning_uncertain_healthy">The model is not confident that the plant is healthy. Please check the alternative diagnoses below — they may apply.</string>
    <string name="warning_viral_variegation_title">Could be natural variegation</string>
    <string name="warning_viral_variegation">Colorful or mottled patterns on ornamental foliage (Calathea, Caladium, Coleus, Croton, Aglaonema…) can closely resemble viral mosaic. If this is a variegated cultivar, the pattern may be perfectly normal — compare with a healthy leaf of the same plant and consider a second opinion before treating.</string>
    <string name="warning_detector_mismatch_title">Detector sees damage</string>
    <string name="warning_detector_mismatch">The detector spotted leaf damage, but the classifier decided the plant is healthy. Try re-scanning from a closer, better-lit angle.</string>
    <string name="warning_blurry_image_title">Photo is too blurry</string>
    <string name="warning_blurry_image">We couldn\'t read the leaf clearly enough to trust a diagnosis. Hold the phone steady, wait for autofocus to lock, and try again.</string>
    <string name="warning_weak_healthy_rerouted_title">Looks unhealthy</string>
    <string name="warning_weak_healthy_rerouted">The plant scored as healthy only narrowly, so we\'re showing the most likely problem instead. Treat this as a lead, not a firm diagnosis — re-scan in better light to confirm.</string>
    <string name="warning_low_confidence_title">Low confidence</string>
    <string name="warning_low_confidence">The model isn\'t very sure about this verdict. Check the alternative diagnoses below and consider re-scanning from a closer, better-lit angle.</string>
    <string name="warning_nap_ood_gated_title">Doesn\'t look like a leaf</string>
    <string name="warning_nap_ood_gated">This image didn\'t look like a plant leaf to the detector, so the result may be unreliable. Frame a single leaf filling most of the photo and try again.</string>
    <string name="warning_disease_suspected_title">Possible problem spotted</string>
    <string name="warning_disease_suspected">The plant looks mostly healthy, but the model also picked up signs of %1$s. Keep an eye on it and re-scan if it spreads.</string>

