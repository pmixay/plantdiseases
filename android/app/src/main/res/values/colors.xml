<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ─── Brand · Vivid leaf-green palette ───────────────────────
         PictureThis-style: a saturated, fresh green that pops on
         white surfaces. The primary is Tailwind green-600 — vivid
         enough to read as a brand identity, dark enough for AAA
         contrast with white text. ``primary_variant`` (green-500)
         drives buttons / FABs where we want a slightly brighter
         feel; ``primary_light`` (green-100) is the standard chip
         background. -->
    <color name="primary">#16A34A</color>
    <color name="primary_light">#DCFCE7</color>
    <color name="primary_variant">#22C55E</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_secondary">#CCFFFFFF</color>
    <!-- ``primary_dark`` / ``secondary`` / ``on_secondary`` are
         consumed by ``values/themes.xml`` (Material 3 colorPrimaryDark
         / colorSecondary / colorOnSecondary attributes); they have no
         direct ``R.color.X`` / ``@color/X`` reference anywhere else.
         Keep them next to ``primary*`` so the theme palette lives in
         one block. -->
    <color name="primary_dark">#15803D</color>
    <color name="secondary">#4ADE80</color>
    <color name="on_secondary">#052E16</color>
    <!-- Gradient stops (ordered dark -> medium -> light). The hero
         leans bright so the green reads as "fresh leaf" rather than
         "deep forest" — PictureThis-style bold header. -->
    <color name="gradient_start">#15803D</color>
    <color name="gradient_mid">#16A34A</color>
    <color name="gradient_end">#4ADE80</color>
    <color name="hero_gradient_start">#15803D</color>
    <color name="hero_gradient_mid">#22C55E</color>
    <color name="hero_gradient_end">#4ADE80</color>
    <color name="hero_solid">#16A34A</color>
    <!-- Text/icon colours for content sitting ON the hero gradient
         (bg_garden_hero / bg_care_plan_gradient). Unlike ``on_primary``
         — which tracks the *button* primary and flips dark in night
         mode — these stay light in both themes because the hero
         gradient stays green in both. -->
    <color name="on_hero">#FFFFFF</color>
    <color name="on_hero_secondary">#CCFFFFFF</color>
    <color name="hero_stat_bg">#29FFFFFF</color>
    <color name="hero_stat_stroke">#52FFFFFF</color>
    <color name="hero_stat_text">#FFFFFF</color>

    <!-- Toolbar background (subtle vertical gradient with mid stop). -->
    <color name="toolbar_top">#16A34A</color>
    <color name="toolbar_bottom">#22C55E</color>
    <color name="toolbar_title">#FFFFFF</color>

    <!-- ─── Surface · Light theme ──────────────────────────────────
         True white surfaces with a very subtle green tint on
         ``surface_variant`` for grouped panels. Body text is a deep
         botanical green-black so dark-on-white reads botanical rather
         than corporate-grey. -->
    <color name="background">#FFFFFF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F0FDF4</color>
    <color name="on_surface">#052E16</color>
    <color name="on_surface_secondary">#4B5563</color>

    <!-- Card tonal ramp for App.GlassCard / *.Strong. Without these the
         cards fall back to the Material3 baseline (lavender-tinted greys)
         which clash with the white + leaf-green palette in light mode.
         Kept as a subtle green-tinted off-white so panels lift off the
         pure-white background without looking corporate-grey. -->
    <color name="surface_container_low">#F4FBF6</color>
    <color name="surface_container">#ECF7F0</color>

    <!-- ─── Soft-card tokens ───────────────────────────────────────
         Layer with android:elevation + the matching frosted background
         (bg_glass_card / bg_glass_card_strong). The "tint" colours are
         designed to read as a sheet of green-tinted glass on photo
         backgrounds; on solid backgrounds they're a soft sheen. -->
    <!-- 65% white, used over photos -->
    <color name="glass_white_soft">#A6FFFFFF</color>
    <!-- 10% primary, panel highlight -->
    <color name="glass_green_tint_soft">#1A16A34A</color>
    <!-- 20% white, inner-glow border -->
    <color name="glass_stroke">#33FFFFFF</color>
    <!-- 40% white, edge highlight -->
    <color name="glass_stroke_strong">#66FFFFFF</color>
    <!-- 30% black, contrast guard for camera/photo overlays -->
    <color name="glass_dark_scrim_strong">#4D000000</color>

    <!-- ─── Semantic colors ─────────────────────────────────────── -->
    <color name="healthy_green">#16A34A</color>
    <color name="healthy_green_bg">#DCFCE7</color>
    <color name="disease_red">#DC2626</color>
    <color name="disease_red_bg">#FEE2E2</color>
    <color name="warning_amber">#D97706</color>
    <color name="warning_amber_bg">#FEF3C7</color>
    <color name="neutral_blue">#2563EB</color>
    <color name="neutral_blue_bg">#DBEAFE</color>

    <!-- ─── Category accents ────────────────────────────────────── -->
    <color name="watering_blue">#2563EB</color>
    <color name="lighting_yellow">#F59E0B</color>
    <!-- Guide-list lighting (sun) icon. Same amber as lighting_yellow
         in light mode; values-night brightens it because amber-400 on
         the dark amber chip background read as near-invisible. -->

    <!-- ─── Misc ────────────────────────────────────────────────── -->
    <color name="scan_frame_color">#80FFFFFF</color>
    <color name="icon_bg">#DCFCE7</color>
    <color name="divider">#E5E7EB</color>
    <color name="card_stroke">#D1D5DB</color>
    <color name="soft_error_icon_bg">#FEE2E2</color>
    <color name="search_highlight">#FEF08A</color>
    <color name="shimmer_base">#E5E7EB</color>
    <color name="shimmer_highlight">#F9FAFB</color>
    <color name="camera_control_scrim">#66000000</color>

    <!-- ─── AI Doctor chat bubbles ───────────────────────────────
         Bot bubble is neutral grey for legibility; user bubble carries
         the brand-green tint. Text uses chat_bubble_text. -->
    <color name="chat_bubble_bot_bg">#F3F4F6</color>
    <color name="chat_bubble_user_bg">#DCFCE7</color>
    <color name="chat_bubble_text">#052E16</color>
    <color name="chat_bubble_text_secondary">#4B5563</color>
</resources>
