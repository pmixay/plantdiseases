<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PlantDiseases" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/primary_light</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- Explicit window background so any blank frame during an
             activity recreate (theme / language switch) paints the app
             background instead of defaulting to black. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_secondary</item>
        <!-- Card tonal containers used by App.GlassCard / *.Strong. Without
             these, cards fall back to the Material3 baseline (lavender greys)
             and clash with the white + green palette in light mode. -->
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <!-- Edge-to-edge: transparent status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Material default for top app bar uses a tonal surface — we
             want our liquid-glass header instead, so leave this off. -->
        <item name="appBarLayoutStyle">@style/Widget.Material3.AppBarLayout</item>

        <!-- Push the leaf-green palette into the default MaterialButton.
             Layouts that explicitly set style="@style/Widget.Material3.Button.*"
             still get that exact style — this only changes the default
             when no style attribute is provided (i.e. naive
             <MaterialButton>). -->
        <item name="materialButtonStyle">@style/App.Button.Filled</item>
        <item name="floatingActionButtonStyle">@style/App.FAB</item>
        <item name="extendedFloatingActionButtonStyle">@style/App.FAB.Extended</item>
    </style>

    <style name="TextAppearance.App.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <!-- Bumped medium → black so the toolbar title sits visibly
             on top of the vivid green hero gradient. -->
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <!-- PictureThis-style heavy headlines on white backgrounds. -->
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title_sm</item>
        <!-- Section titles a step heavier (medium → bold) — pairs
             with the heavier headline above. -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="App.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_light</item>
    </style>

    <!-- ─── Surface card ────────────────────────────────────────
         Flat Material 3 surface container. No glass overlay, no
         translucent green tint — just an opaque card on
         ``surfaceContainerLow`` with a soft corner radius and a
         small elevation so it lifts off the screen background.
         Used everywhere a panel/card is needed. -->
    <style name="App.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>

    <style name="App.GlassCard.Strong">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="App.Animation.DiseaseAppearance" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/fade_disease_appearance_in</item>
        <item name="android:windowExitAnimation">@anim/fade_disease_appearance_out</item>
    </style>

    <!-- Profile stat tiles (the count rows beside the health-rate ring). -->
    <style name="Profile.StatTile" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_stat_pill</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:paddingVertical">10dp</item>
    </style>
    <style name="Profile.StatNum" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:text">0</item>
    </style>
    <style name="Profile.StatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_md</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
    </style>

    <!-- Compact pill chip for status / count badges. -->
    <style name="App.GlassPill" parent="">
        <item name="android:background">@drawable/bg_glass_pill</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:paddingVertical">@dimen/space_xs</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ─── Button shape ────────────────────────────────────────────
         Almost-pill rounded buttons (24dp on a ~48dp tall surface
         reads as fully pill from a phone arm's length) — the
         signature PictureThis "soft tablet" look. Material3's default
         is the medium-component shape (~12dp); we override per-style
         so existing TextButton / IconButton callsites aren't surprised. -->
    <style name="ShapeAppearance.App.Button" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- ─── Buttons: leaf-green primary, soft tonal secondary ──── -->
    <style name="App.Button.Filled" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="rippleColor">@color/primary_dark</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">@dimen/space_2xl</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/primary_light</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="rippleColor">@color/primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">@dimen/space_2xl</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="iconTint">@color/primary_dark</item>
    </style>

    <style name="App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/primary_light</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <!-- ─── FABs ────────────────────────────────────────────────────
         The vivid green primary on the new white canvas would burn
         readers' retinas at full saturation, so the FAB uses the
         slightly darker ``primary_dark`` for the surface and full
         white for the icon. Extended FAB inherits the same. -->
    <style name="App.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
        <item name="rippleColor">@color/primary_dark</item>
        <item name="elevation">6dp</item>
        <item name="hoveredFocusedTranslationZ">8dp</item>
        <item name="pressedTranslationZ">10dp</item>
    </style>

    <style name="App.FAB.Extended" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="rippleColor">@color/primary_dark</item>
        <item name="elevation">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>
