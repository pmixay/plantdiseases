<?xml version="1.0" encoding="utf-8"?>
<!-- Grid column counts. Overridden per smallest-width bucket
     (values-sw600dp / values-sw720dp) so the photo gallery and the community
     feed use more columns on tablets instead of two oversized ones. -->
<resources>
    <integer name="gallery_span_count">2</integer>
    <integer name="community_span_count">2</integer>

    <!-- Lines of the Wikipedia description the species-info card shows before
         it offers "show full description". Kept short because the card is
         embedded under diagnosis content, not read as an article. -->
    <integer name="species_info_collapsed_lines">4</integer>

    <!-- Lines of the Wikipedia lead section the species screen shows before it
         offers "show full description". Longer than the card's clamp because
         this screen is where the article is meant to be read. -->
    <integer name="species_extract_collapsed_lines">8</integer>

    <!-- Common-problems rows kept visible before "show all N" appears. The
         fallback path renders the whole 17-item bundled catalogue. -->
    <integer name="species_problems_collapsed_rows">2</integer>

    <!-- Treatment / prevention steps shown before "show all N". -->
    <integer name="treatment_steps_collapsed_rows">3</integer>
</resources>
