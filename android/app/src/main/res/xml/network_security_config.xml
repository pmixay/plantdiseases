<?xml version="1.0" encoding="utf-8"?>
<!--
    RELEASE config: HTTPS only, no exceptions.

    The server base URL is fixed at build time via BuildConfig.API_BASE_URL
    (default https://pdis.arbuz.lol/) and there is no in-app server-URL
    override, so a shipped build has no legitimate reason to speak cleartext
    to anything.

    The localhost / 10.0.2.2 cleartext exemption a developer needs for
    -PAPI_BASE_URL=http://10.0.2.2:8000 now lives in the debug-only variant at
    app/src/debug/res/xml/network_security_config.xml, which resource merging
    substitutes for this file in debug builds. It used to live here as a plain
    <domain-config>, which meant it was compiled into the release APK too.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
