<?xml version="1.0" encoding="utf-8"?>
<!--
    RELEASE config: HTTPS only, no exceptions.

    Server base URLs are fixed at build time via BuildConfig.APP_API_BASE_URL
    and BuildConfig.ACCOUNT_API_BASE_URL
    (default https://pdis.arbuz.lol/) and there is no in-app server-URL
    override, so a shipped build has no legitimate reason to speak cleartext
    to anything.

    The localhost / 10.0.2.2 cleartext exemption a developer needs for
    -PAPP_API_BASE_URL=http://10.0.2.2:18000 and
    -PACCOUNT_API_BASE_URL=http://10.0.2.2:18001 lives in the debug and staging
    source sets, which resource merging substitutes for this file in those
    builds. It used to live here as a plain <domain-config>, which meant it was
    compiled into the production release APK too.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
