<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ─── Brand: Vivid leaf-green palette (dark) ───────────────
         On dark surfaces the saturated greens read overwhelming and
         the body-text contrast inverts. We pull primary up to Tailwind
         green-400 and keep
         primary_light as a deep desaturated green so chips on the
         dark surface stay readable. -->
    <color name="primary">#4ADE80</color>
    <color name="primary_light">#14532D</color>
    <color name="primary_variant">#22C55E</color>
    <color name="on_primary">#052E16</color>
    <!-- Official Yandex ID main-button palette for a dark surface. -->
    <color name="yandex_button_background">#FFFFFF</color>
    <color name="yandex_button_on_background">#000000</color>
    <color name="yandex_button_ripple">#E5E7EB</color>
    <!-- Theme overrides for ``values/themes.xml``'s colorPrimaryDark /
         colorSecondary / colorOnSecondary attributes. -->
    <color name="primary_dark">#16A34A</color>
    <color name="secondary">#22C55E</color>
    <color name="on_secondary">#052E16</color>


    <!-- ─── Surface: Dark theme ─────────────────────────────────── -->
    <color name="background">#0A0F0C</color>
    <color name="surface">#131A14</color>
    <color name="surface_variant">#1A211B</color>
    <color name="on_surface">#F0FDF4</color>
    <!-- Muted ink (see values/colors.xml): pale mint, 13:1 on surface. -->
    <color name="on_surface_secondary">#CFE3D6</color>

    <!-- Card tonal ramp for App.GlassCard / *.Strong (see light theme).
         Slightly lighter than the dark-green surface so cards lift off
         the background. -->
    <color name="surface_container_low">#161E18</color>
    <color name="surface_container">#1C261E</color>
    <!-- Material 3 dialogs and menus paint these; without them they fall back
         to the stock lilac baseline. -->
    <color name="surface_container_high">#222D24</color>
    <color name="surface_container_highest">#28342A</color>
    <color name="surface_container_lowest">#0E140F</color>

    <!-- ─── Soft-card tokens (dark) ────────────────────────────────
         On dark backgrounds we use a faint white sheen instead of an
         opaque tint so the surface still reveals the live wallpaper /
         photo behind it. -->
    <color name="glass_white_soft">#14FFFFFF</color>
    <color name="glass_green_tint_soft">#1F4ADE80</color>
    <color name="glass_stroke">#33FFFFFF</color>
    <color name="glass_stroke_strong">#52FFFFFF</color>
    <color name="glass_dark_scrim_strong">#66000000</color>

    <!-- ─── Semantic colors ─────────────────────────────────────── -->
    <color name="healthy_green">#4ADE80</color>
    <color name="healthy_green_bg">#14532D</color>
    <color name="disease_red">#F87171</color>
    <color name="disease_red_bg">#3A1B1B</color>
    <color name="danger_button">#DC2626</color>
    <color name="on_danger_button">#FFFFFF</color>
    <color name="warning_amber">#FBBF24</color>
    <color name="warning_amber_bg">#3A2E1B</color>
    <color name="confidence_gradient_mid">#3A251B</color>
    <color name="neutral_blue">#60A5FA</color>
    <color name="neutral_blue_bg">#1E2D40</color>

    <!-- ─── Category accents ────────────────────────────────────── -->
    <color name="watering_blue">#60A5FA</color>
    <!-- Brighter sun icon for the Guide list in dark mode (amber-300):
         the light-mode amber sank into the dark chip background. -->

    <!-- ─── Misc ────────────────────────────────────────────────── -->
    <color name="scan_frame_color">#80FFFFFF</color>
    <color name="icon_bg">#14532D</color>
    <color name="divider">#1F2820</color>
    <color name="card_stroke">#1F2820</color>
    <!-- See values/colors.xml. Low-alpha white so the fixed seam is actually
         visible against the near-black page as tabs slide under it — the night
         `divider` (#1F2820) sits too close to the background to register. -->
    <color name="toolbar_divider">#24FFFFFF</color>
    <color name="soft_error_icon_bg">#2A2421</color>
    <color name="search_highlight">#665C3A</color>
    <color name="shimmer_base">#192118</color>
    <color name="shimmer_highlight">#243023</color>

    <!-- ─── AI Doctor chat bubbles (dark) ───────────────────────── -->
    <color name="chat_bubble_bot_bg">#1F2820</color>
    <color name="chat_bubble_user_bg">#14532D</color>
    <color name="chat_bubble_text">#F0FDF4</color>
