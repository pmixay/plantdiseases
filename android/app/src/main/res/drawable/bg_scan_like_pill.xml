<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal pill for the community opinion sheet's like control. Neutral
     surface tone (not a status-badge color like bg_pill_secondary's
     colorSecondaryContainer) since this is an everyday interactive
     control, not a warning/offline state. 999dp always clamps to a true
     capsule regardless of height — see bg_pill_secondary for the same trick. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_variant" />
    <corners android:radius="999dp" />
</shape>
