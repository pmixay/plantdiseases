<?xml version="1.0" encoding="utf-8"?>
<!-- The composer's "add photo" tile: a rounded square with a dashed green edge,
     the same size and corners as the photo thumbnails beside it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/forum_ai_stroke">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/forum_ai_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/forum_ai_stroke"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</ripple>
