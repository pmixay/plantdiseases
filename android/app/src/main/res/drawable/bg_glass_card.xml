<?xml version="1.0" encoding="utf-8"?>
<!--
    Light-mode card surface. The translucent inner-stroke "glass" look
    didn't read well against the pale-green page background (left a
    halo-like frame around every card), so light mode now renders a
    flat opaque white surface. The frosted-glass variant lives under
    res/drawable-night/ for dark mode.
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
