<?xml version="1.0" encoding="utf-8"?>
<!--
    Stronger liquid-glass surface for primary content cards (status,
    description). Less transparency than bg_glass_card, brighter rim
    stroke, slightly rounder corners.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_white_strong" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_stroke_strong" />
        </shape>
    </item>
</layer-list>
