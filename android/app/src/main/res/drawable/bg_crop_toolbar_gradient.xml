<?xml version="1.0" encoding="utf-8"?>
<!-- Crop-screen action bar background. Unlike bg_toolbar_gradient (which
     follows the theme and turns bright green in light mode), this uses a
     fixed deep-botanical gradient in BOTH themes so the white Done /
     cancel / title controls always have enough contrast. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#14532D"
                android:centerColor="#166534"
                android:endColor="#15803D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.78"
                android:centerY="0.18"
                android:startColor="#22FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
