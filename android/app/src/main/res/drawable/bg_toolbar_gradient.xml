<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar background. Vertical (top->bottom) gradient over the
     deep botanical greens. We layer a subtle radial highlight on top
     so the bar feels like a curved sheet of green glass catching
     overhead light, not a flat painted strip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/toolbar_top"
                android:centerColor="@color/gradient_mid"
                android:endColor="@color/toolbar_bottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.78"
                android:centerY="0.18"
                android:startColor="@color/glass_white_soft"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
