<?xml version="1.0" encoding="utf-8"?>
<!-- The Community menu's shadow, drawn as rounded layers rather than by
     elevation: some phones shade a popup window's whole rectangle, which
     showed as grey square corners. The card itself (bg_forum_menu) sits
     10dp inside, matching popup_forum_menu's padding. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#04000000" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:left="1dp"
        android:right="1dp"
        android:top="3dp">
