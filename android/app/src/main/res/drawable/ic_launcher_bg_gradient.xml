<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the brand green vertical gradient. The launcher
     applies its own mask (rounded square / circle), so this just fills the
     108x108 layer edge to edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#35A656"
        android:endColor="#1C8041" />
</shape>
