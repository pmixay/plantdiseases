<?xml version="1.0" encoding="utf-8"?>
<!-- Bot chat bubble — frosted-glass styling so the conversation feels
     soft even on top of the green sheet behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chat_bubble_bot_bg" />
    <corners android:radius="@dimen/radius_lg" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke" />
</shape>
