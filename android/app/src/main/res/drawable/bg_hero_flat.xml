<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-bleed tab hero (Garden / Profile). Same leaf-green gradient as
    bg_garden_hero but with square corners: the hero reaches every screen edge,
    so rounded corners would only leave dark gaps. (bg_garden_hero keeps its
    rounded bottom for the sheet/detail panels that still need it.)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/hero_gradient_start"
        android:centerColor="@color/hero_gradient_mid"
        android:endColor="@color/hero_gradient_end" />
</shape>
