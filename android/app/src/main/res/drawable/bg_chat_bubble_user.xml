<?xml version="1.0" encoding="utf-8"?>
<!-- User chat bubble — leaf-tinted glass with a soft inner stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chat_bubble_user_bg" />
    <corners
        android:topLeftRadius="@dimen/radius_lg"
        android:topRightRadius="@dimen/radius_lg"
        android:bottomLeftRadius="@dimen/radius_lg"
        android:bottomRightRadius="@dimen/space_xs" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke" />
</shape>
