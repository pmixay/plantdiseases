<?xml version="1.0" encoding="utf-8"?>
<!-- Camera bottom-controls panel — uses the shared glass panel surface
     so the shutter row reads as a sheet of frosted leaf glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners
                android:topLeftRadius="@dimen/radius_xl"
                android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_green_tint_soft" />
            <corners
                android:topLeftRadius="@dimen/radius_xl"
                android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
</layer-list>
