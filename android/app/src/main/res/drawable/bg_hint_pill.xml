<?xml version="1.0" encoding="utf-8"?>
<!-- Floating hint badge — sits on top of the camera preview / a photo,
     so it stays dark/glass for legibility on bright frames. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_dark_scrim_strong" />
    <corners android:radius="@dimen/radius_round" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke_strong" />
</shape>
