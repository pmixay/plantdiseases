<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: a plant sprig — an upright central leaf over a stem
     with two pairs of side leaves (white on the right, pale green on the left).
     Content sits inside the central 72x72 safe zone (18..90 on the 108 grid).
     Each leaf is the same almond path (base at the local origin, tip up at
     0,-24) placed by a <group> that translates the base onto the stem and
     rotates it outward. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,48 L54,86" />

    <!-- Lower-left leaf (pale green) -->
    <group android:translateX="54" android:translateY="68" android:rotation="-72">
        <path android:fillColor="#C2E6CC"
            android:pathData="M0,0 C7,-6 7,-18 0,-24 C-7,-18 -7,-6 0,0 Z" />
    </group>
    <!-- Lower-right leaf (white) -->
    <group android:translateX="54" android:translateY="64" android:rotation="72">
        <path android:fillColor="#FFFFFF"
            android:pathData="M0,0 C7,-6 7,-18 0,-24 C-7,-18 -7,-6 0,0 Z" />
    </group>
    <!-- Upper-left leaf (pale green) -->
    <group android:translateX="54" android:translateY="56" android:rotation="-42">
        <path android:fillColor="#C2E6CC"
            android:pathData="M0,0 C7,-6 7,-18 0,-24 C-7,-18 -7,-6 0,0 Z" />
    </group>
    <!-- Upper-right leaf (white) -->
    <group android:translateX="54" android:translateY="52" android:rotation="42">
        <path android:fillColor="#FFFFFF"
            android:pathData="M0,0 C7,-6 7,-18 0,-24 C-7,-18 -7,-6 0,0 Z" />
    </group>
    <!-- Top central leaf (white) -->
    <group android:translateX="54" android:translateY="46">
        <path android:fillColor="#FFFFFF"
            android:pathData="M0,0 C7,-6 7,-18 0,-26 C-7,-18 -7,-6 0,0 Z" />
    </group>
</vector>
