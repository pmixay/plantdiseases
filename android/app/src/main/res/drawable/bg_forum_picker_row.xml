<?xml version="1.0" encoding="utf-8"?>
<!-- Composer picker row: rounded tinted surface with a ripple kept inside it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/forum_card_stroke">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/surface_container_low" />
            <stroke
                android:width="1dp"
                android:color="@color/forum_card_stroke" />
        </shape>
    </item>
</ripple>
