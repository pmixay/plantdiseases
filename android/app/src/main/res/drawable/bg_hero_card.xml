<?xml version="1.0" encoding="utf-8"?>
<!-- Garden / Profile hero card background: the brand leaf-green gradient with
     all four corners rounded, so the hero reads as a floating card that sits
     below the status bar (the fragment pads the scroll view by the status-bar
     inset) with side margins from the parent padding. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/hero_gradient_start"
        android:centerColor="@color/hero_gradient_mid"
        android:endColor="@color/hero_gradient_end" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
