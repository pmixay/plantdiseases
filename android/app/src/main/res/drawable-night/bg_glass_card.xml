<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-mode card surface — flat opaque ``surface`` colour. The
    previous frosted-white overlay produced a green-tinted halo on
    the dark green background; a plain surface fill keeps cards
    legible without an aesthetic edge.
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
