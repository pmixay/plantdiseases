<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-mode glass card: translucent white sheen over the dark
    background so the frosted-glass effect reads on top of the
    gradient. Light-mode uses the flat default in res/drawable/.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_white" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
