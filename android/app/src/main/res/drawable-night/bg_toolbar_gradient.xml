<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode toolbar: same shape as the day variant but with a
     dimmer rim highlight so the gradient doesn't blow out blacks. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/toolbar_top"
                android:centerColor="@color/gradient_mid"
                android:endColor="@color/toolbar_bottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.78"
                android:centerY="0.18"
                android:startColor="@color/glass_green_tint_soft"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
