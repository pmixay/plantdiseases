<?xml version="1.0" encoding="utf-8"?>
<!--
    A single plant row in the Garden list. Soft PictureThis-style card:
    no stroke, gentle elevation, 96dp rounded thumbnail with a health
    dot badge, then name / health-status column. The thumbnail image,
    health-dot colour and status line are populated at bind time by
    RoomDetailActivity.buildPlantRow.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plant_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:rippleColor="@color/primary_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_lg">

        <!-- Rounded-rect thumbnail on the radius_md design token (was a
             circle that clashed with every other card corner). The
             health dot sits cleanly inside the top-end corner instead
             of hanging over the edge. -->
        <FrameLayout
            android:id="@+id/plant_thumb_wrap"
            android:layout_width="96dp"
            android:layout_height="96dp">

            <ImageView
                android:id="@+id/plant_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_thumb_rounded"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <View
                android:id="@+id/plant_health_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_xs"
                android:visibility="gone"
                tools:background="@color/healthy_green"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/plant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Monstera" />

            <TextView
                android:id="@+id/plant_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body_sm"
                android:fontFamily="sans-serif-medium"
                tools:text="Healthy · 92%" />

        </LinearLayout>

        <!-- Only relevant inside RoomDetailActivity's list (tap opens the
             plant profile) — GardenFragment no longer renders this card
             directly, so this is unconditionally visible now that the
             Garden tab shows room cards instead. -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="@dimen/space_sm"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@null"
            app:tint="@color/on_surface_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
