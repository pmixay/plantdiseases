<?xml version="1.0" encoding="utf-8"?>
<!--
    One post in the "Scans near you" feed. Photo on top with the author avatar
    (top-start) and a views/comments count pill (top-end) overlaid on it, so
    the footer text gets the full card width: diagnosis/nickname, then the
    place, then a dedicated distance·time line that always stays visible.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Scan photo + overlays -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_nearby_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="false"
                app:shimmer_base_color="@color/shimmer_base"
                app:shimmer_duration="1000"
                app:shimmer_highlight_color="@color/shimmer_highlight">

                <ImageView
                    android:id="@+id/iv_nearby_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="?attr/colorSurfaceVariant"
                    android:contentDescription="@null" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Anonymous author avatar (deterministic colour + monogram).
                 Overlaid top-start so the footer text below spans full width.
                 Decorative: TalkBack would read "KX" as meaningless noise. -->
            <TextView
                android:id="@+id/tv_nearby_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_xs"
                android:gravity="center"
                android:background="@drawable/bg_circle_surface_variant"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                tools:text="KX" />

            <!-- Views + comments(opinions) count pill (top-end). Each part is
                 hidden when its count is 0; the whole pill hides when both are. -->
            <LinearLayout
                android:id="@+id/ll_nearby_counts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/bg_glass_dark_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_nearby_views"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="3dp"
                    android:gravity="center_vertical"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    app:drawableStartCompat="@drawable/ic_eye"
                    app:drawableTint="@android:color/white"
                    tools:text="12" />

                <TextView
                    android:id="@+id/tv_nearby_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:drawablePadding="3dp"
                    android:gravity="center_vertical"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    app:drawableStartCompat="@drawable/ic_comment"
                    app:drawableTint="@android:color/white"
                    tools:text="3" />
            </LinearLayout>
        </FrameLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/tv_nearby_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body_sm"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Powdery Mildew" />

            <TextView
                android:id="@+id/tv_nearby_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Powdery mildew · Berlin, Germany" />

            <!-- Distance + time on their own line so they're never truncated
                 by a long place name (the feed sorts by recency). -->
            <TextView
                android:id="@+id/tv_nearby_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="≈ 3 km near you · 2h" />

            <!-- Scanner is waiting on the community for a second opinion. -->
            <TextView
                android:id="@+id/tv_nearby_wants_opinion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="@string/community_wants_opinion_badge"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/warning_amber"
                android:fontFamily="sans-serif-medium"
                app:drawableStartCompat="@drawable/ic_community"
                app:drawableTint="@color/warning_amber"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nearby_opinion"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="6dp"
                android:textSize="@dimen/text_body_sm"
                android:text="@string/nearby_scans_second_opinion"
                app:icon="@drawable/ic_comment"
                app:iconSize="16dp"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
