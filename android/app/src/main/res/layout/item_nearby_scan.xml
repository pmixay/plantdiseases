<?xml version="1.0" encoding="utf-8"?>
<!--
    One shared scan in the list the community map opens for a cluster:
    the diagnosis with place and distance/time, a views count, then the
    full-width photo. No author: scans are shown without identity.
    Tapping the photo expands it full screen.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_md">

    <!-- Header: diagnosis/place/time stacked, views at the end. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nearby_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body_sm"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Powdery mildew" />

            <!-- Place on its own line, so a long place name can't ellipsize
                 the distance and time below it. -->
            <TextView
                android:id="@+id/tv_nearby_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Berlin, Germany" />

            <TextView
                android:id="@+id/tv_nearby_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="≈ 3 km, 2 hr. ago" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_eye"
                app:tint="@color/on_surface_secondary" />

            <TextView
                android:id="@+id/tv_nearby_views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/on_surface"
                tools:text="48" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scan photo, full row width. Tapping it expands the photo. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_nearby_photo"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            app:shimmer_auto_start="false"
            app:shimmer_base_color="@color/shimmer_base"
            app:shimmer_duration="1000"
            app:shimmer_highlight_color="@color/shimmer_highlight">

            <ImageView
                android:id="@+id/iv_nearby_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="?attr/colorSurfaceVariant"
                android:contentDescription="@null" />

        </com.facebook.shimmer.ShimmerFrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="@color/surface_variant" />

</LinearLayout>
