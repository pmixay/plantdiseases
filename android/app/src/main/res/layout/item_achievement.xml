<?xml version="1.0" encoding="utf-8"?>
<!-- One achievement on the helper profile: badge, title, progress toward the
     next tier. Earned badges are green, completed ones gold, locked ones grey.
     HelperProfileActivity.AchievementAdapter binds it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/App.ForumCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="148dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_badge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_forum_avatar"
                android:contentDescription="@null"
                android:padding="11dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_tier"
                style="@style/Forum.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_body" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_achievement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/surface_container"
            app:trackCornerRadius="3dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/tv_progress"
            style="@style/Forum.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
