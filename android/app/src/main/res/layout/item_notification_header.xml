<?xml version="1.0" encoding="utf-8"?>
<!-- "New" / "Earlier" heading in the notification centre. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_notification_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif-medium"
    android:letterSpacing="0.06"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_xs"
    android:textAllCaps="true"
    android:textColor="@color/on_surface_secondary"
    android:textSize="@dimen/text_caption" />
