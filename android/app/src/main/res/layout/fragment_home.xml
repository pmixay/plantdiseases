<?xml version="1.0" encoding="utf-8"?>
<!--
    Home — a visual discovery feed. Greeting, two hero actions (scan health /
    identify species), a compact tools row, then the image carousels that are
    the centerpiece: Trending species nearby (Wikipedia photos), Popular
    diseases, and the Disease guide. (Stats &amp; advice live on the Profile tab.)
    Carousels are horizontal RecyclerViews filled by HomeFragment;
    the species/popular sections hide themselves when there's no data.
-->
<androidx.core.widget.NestedScrollView
    android:id="@+id/home_scroll"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_3xl">

        <!-- Shared offline notice — hidden until the connectivity observer
             reports no reachable network (HomeFragment wires it up). The
             carousels keep serving their cached / bundled bundles underneath. -->
        <com.plantdiseases.app.ui.common.OfflineNoticeView
            android:id="@+id/offline_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm" />

        <!-- Page title + nearby-scans action. Used to live in the shared
             MainActivity toolbar, pinned above the pager; that title only
             updated once a swipe settled, so it read as floating
             disconnected from the page sliding underneath it mid-drag.
             Living here instead, it's part of this page's own content and
             slides with it like the greeting below. The nearby-scans bell
             moves here too — it used to be a toolbar menu item scoped to
             this fragment's lifecycle, which only worked while the shared
             toolbar was visible on this tab. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/content_gutter">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_home"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01" />

            <ImageButton
                android:id="@+id/btn_nearby_scans"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_community"
                app:tint="@color/on_surface"
                android:contentDescription="@string/nearby_scans_cd" />

        </LinearLayout>

        <!-- Greeting -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingHorizontal="@dimen/content_gutter"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:id="@+id/tv_greeting_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/content_gutter"
            android:text="@string/home_subtitle"
            android:textColor="@color/on_surface_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Hero actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/content_gutter">

            <!-- Both hero cards use match_parent height against a wrap_content
                 row: a horizontal LinearLayout then stretches the shorter card
                 to the taller one, so they stay equal height regardless of how
                 many lines the title/subtitle wrap to (e.g. longer RU strings). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_scan"
                        app:tint="@android:color/white"
                        android:contentDescription="@string/home_scan_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/home_scan_title"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_title_sm" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_scan_sub"
                        android:textColor="#D9FFFFFF"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_identify"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_plant_placeholder"
                        app:tint="@color/primary"
                        android:contentDescription="@string/home_identify_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/home_identify_title"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_title_sm" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_identify_sub"
                        android:textColor="@color/on_surface_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Compact tools row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/content_gutter">

            <LinearLayout
                android:id="@+id/tile_light"
                style="@style/HomeToolTile">

                <ImageView style="@style/HomeToolTileIcon" android:src="@drawable/ic_light" />

                <TextView style="@style/HomeToolTileLabel" android:text="@string/home_tool_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_water"
                style="@style/HomeToolTile">

                <ImageView style="@style/HomeToolTileIcon" android:src="@drawable/ic_watering" />

                <TextView style="@style/HomeToolTileLabel" android:text="@string/home_tool_water" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_symptom"
                style="@style/HomeToolTile">

                <ImageView style="@style/HomeToolTileIcon" android:src="@drawable/ic_disease" />

                <TextView style="@style/HomeToolTileLabel" android:text="@string/home_tool_symptom" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_guide"
                style="@style/HomeToolTile">

                <ImageView style="@style/HomeToolTileIcon" android:src="@drawable/ic_guide" />

                <TextView style="@style/HomeToolTileLabel" android:text="@string/home_tool_guide" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trending species nearby -->
        <LinearLayout
            android:id="@+id/section_species"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/content_gutter">

                <TextView
                    android:id="@+id/tv_species_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_trending"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_title_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_trending_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <com.plantdiseases.app.util.NestedScrollableHost
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_species"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/content_gutter" />
            </com.plantdiseases.app.util.NestedScrollableHost>
        </LinearLayout>

        <!-- Popular diseases -->
        <LinearLayout
            android:id="@+id/section_popular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/content_gutter"
                android:text="@string/home_popular_diseases"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title_sm"
                android:textStyle="bold" />

            <com.plantdiseases.app.util.NestedScrollableHost
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_popular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/content_gutter" />
            </com.plantdiseases.app.util.NestedScrollableHost>
        </LinearLayout>

        <!-- Disease guide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/content_gutter">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_disease_guide"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_title_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_guide_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_see_all"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <com.plantdiseases.app.util.NestedScrollableHost
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/content_gutter" />
            </com.plantdiseases.app.util.NestedScrollableHost>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
