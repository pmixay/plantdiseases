<?xml version="1.0" encoding="utf-8"?>
<!--
    Garden tab — a single surface (no pane switcher). Room cards
    (item_room_card rows inflated into garden_rooms_container, with an
    Unassigned bucket at the bottom when any plant has no room) sit under
    the do-today queue.

    The two calendars that used to live behind a segmented control here
    are gone from this screen: the care month grid moved to its own
    screen (ui/garden/care/CareCalendarActivity, opened by
    garden_care_calendar_button below), and the lunar calendar is now
    shown per plant on the plant detail screen only.

    Both secondary destinations (Care calendar, Add room) sit in one paired
    row at a fixed position under the header: Add room used to trail every room
    card, so a long list buried the button you need when the list is long.

    The page header (title, search action, summary) is the plain header
    shared by every tab: no coloured block.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/garden_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Bottom padding clears the overlaid Add-plant FAB so the last card
         is never hidden behind it (clipToPadding=false keeps the
         scrollbar full-height). -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/garden_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_gutter"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg">

            <!-- Page header, like the Home and Community tabs: title with the
                 search action beside it, then the garden summary. The toolbar
                 is hidden on this tab (see MainActivity); GardenFragment pads
                 the scroll view by the status-bar inset. -->
            <LinearLayout
                android:id="@+id/garden_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/garden_summary_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.01"
                        android:text="@string/garden_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_title" />

                    <ImageButton
                        android:id="@+id/garden_search_toggle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/garden_search_hint"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/on_surface" />

                </LinearLayout>

                <TextView
                    android:id="@+id/garden_summary_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/garden_subtitle"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- The garden's two secondary destinations, paired at a fixed
                 position under the header. "Add room" used to sit BELOW every
                 room card, so the control you reach for once the list is long
                 was the one the long list pushed off screen. Both hide while
                 the garden is empty — the empty state offers its own Add room,
                 and a month grid with nothing to schedule is a dead end. -->
            <LinearLayout
                android:id="@+id/garden_action_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_care_calendar_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/garden_care_calendar"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_add_room"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/room_add"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

            </LinearLayout>

            <!-- The actionable queue belongs on the Garden surface itself,
                 not behind a calendar. Rows are rendered in place with a
                 one-tap checkbox; completion exposes Snackbar Undo. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/garden_do_today_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/garden_do_today_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_title_sm" />

                    <TextView
                        android:id="@+id/garden_do_today_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_body_sm"
                        tools:text="3 tasks, 1 overdue" />

                    <LinearLayout
                        android:id="@+id/garden_do_today_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Search — only shown once the garden grows past a handful of
                 plants/rooms, toggled by garden_search_toggle above. Filters
                 by room name AND by any plant name inside that room. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/garden_search_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:boxCornerRadiusTopStart="@dimen/radius_md"
                app:boxCornerRadiusTopEnd="@dimen/radius_md"
                app:boxCornerRadiusBottomStart="@dimen/radius_md"
                app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="@color/on_surface_secondary"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/garden_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/garden_search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="@dimen/text_body" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Rooms pane ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/garden_rooms_pane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Room cards (item_room_card) + the Unassigned bucket are
                     inflated here at runtime. -->
                <LinearLayout
                    android:id="@+id/garden_rooms_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Empty state — the garden has no plants at all. Distinct from
                 "plants exist but no rooms yet", which renders inside the
                 Rooms pane instead (see GardenFragment.renderRooms). -->
            <LinearLayout
                android:id="@+id/garden_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_2xl"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:src="@drawable/illustration_empty_garden"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/empty_garden_title"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_headline"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/empty_garden_hint"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_empty_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/empty_garden_cta_add"
                    app:icon="@drawable/ic_garden"
                    app:iconGravity="textStart" />

                <!-- The Rooms pane (and its own "+ Add room" button) is
                     hidden entirely while the garden has no plants, which
                     left room creation with no reachable entry point at all
                     on a fresh install. Same string/icon/action as that
                     button, just reachable from here too. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_empty_add_room"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/room_add"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Starts invisible: the FAB's final visibility (shown for a populated
         garden, hidden behind the empty-state CTA otherwise) isn't known
         until plants load. Revealing it only after the first render avoids
         the "Add plant" button flashing for a frame before the real state
         is committed. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/garden_add_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_xl"
        android:text="@string/add_plant"
        android:visibility="invisible"
        app:icon="@drawable/ic_garden" />

</FrameLayout>
