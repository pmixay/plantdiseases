<?xml version="1.0" encoding="utf-8"?>
<!--
    Garden tab — rebuilt per the Garden refactor (docs/ROADMAP.md
    "Garden refactor" + the approved mockup). Two panes behind a
    segmented control:

      • Rooms — room cards (item_room_card rows inflated into
        garden_rooms_container) with an Unassigned bucket at the bottom
        when any plant has no room.
      • Care calendar — a month grid (populated by CareCalendarView,
        added to garden_calendar_container at runtime) + legend + a
        "Today, N tasks" summary card that opens the day view.

    The hero card, search box and empty state keep their existing shape
    (bg_hero_card, the same illustration) — this app's header language
    is shared across every tab, so it stays even though the mockup's
    background is flatter; only the CONTENT changes (search icon,
    segmented control, room cards instead of a flat plant list).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/garden_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Bottom padding clears the overlaid Add-plant FAB so the last card
         is never hidden behind it (clipToPadding=false keeps the
         scrollbar full-height). -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/garden_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_gutter"
            android:paddingVertical="@dimen/space_lg">

            <!-- Hero card: rounded leaf-green gradient panel. The toolbar is
                 hidden on this tab (see MainActivity), so GardenFragment pads
                 the scroll view by the status-bar inset to drop the card below
                 the system clock; the parent's space_lg padding gives the side
                 margins. -->
            <LinearLayout
                android:id="@+id/garden_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_card"
                android:paddingHorizontal="@dimen/space_xl"
                android:paddingTop="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- No leading icon here — the plant/sprout glyph that
                         used to sit on this row had no id and no listener
                         anywhere in the codebase; it was pure decoration
                         with no evidence of intended behaviour, so it's
                         removed rather than wired up to something invented. -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/garden_search_toggle"
                        android:layout_width="@dimen/species_info_touch_target"
                        android:layout_height="@dimen/species_info_touch_target"
                        android:background="@drawable/bg_circle_semi"
                        android:src="@android:drawable/ic_menu_search"
                        android:contentDescription="@string/garden_search_hint"
                        app:tint="@color/on_hero" />

                </LinearLayout>

                <TextView
                    android:id="@+id/garden_summary_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/garden_title"
                    android:textColor="@color/on_hero"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/garden_summary_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/garden_subtitle"
                    android:textColor="@color/on_hero_secondary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Rooms | Care calendar. Fixed mode — exactly two destinations,
                 nothing to scroll horizontally. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/garden_segment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:tabMode="fixed"
                app:tabGravity="fill" />

            <!-- Search — only shown once the garden grows past a handful of
                 plants/rooms, toggled by garden_search_toggle above. Filters
                 by room name AND by any plant name inside that room. Hidden
                 entirely on the calendar pane (searching a month grid means
                 nothing). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/garden_search_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:boxCornerRadiusTopStart="@dimen/radius_md"
                app:boxCornerRadiusTopEnd="@dimen/radius_md"
                app:boxCornerRadiusBottomStart="@dimen/radius_md"
                app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="@color/on_surface_secondary"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/garden_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/garden_search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="@dimen/text_body" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Rooms pane ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/garden_rooms_pane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Room cards (item_room_card) + the Unassigned bucket are
                     inflated here at runtime. -->
                <LinearLayout
                    android:id="@+id/garden_rooms_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_add_room"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/room_add"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <!-- ── Calendars pane ─────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/garden_calendar_pane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Care / Lunar inner toggle. Deliberately NOT another
                     full-width TabLayout: two identical tab bars stacked
                     directly on top of each other (garden_segment above
                     switches Rooms/Calendars; this used to be a second one
                     for Care/Lunar) gave the eye no way to tell which one
                     was the parent, so the screen read as four peer
                     destinations instead of two containing two. A segmented
                     button group is the M3 control for "switch the view
                     within a destination" and is visually lighter than a
                     tab bar, which is the whole point. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/garden_calendar_segment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Button">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/garden_calendar_toggle_care"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/garden_calendar_tab_care" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/garden_calendar_toggle_lunar"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/garden_calendar_tab_lunar" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/garden_care_subpane"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- CareCalendarView is added here at runtime (see
                         ui/garden/care/CareCalendarView.kt). -->
                    <FrameLayout
                        android:id="@+id/garden_calendar_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/garden_calendar_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal"
                        android:gravity="center" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/garden_today_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp"
                        app:rippleColor="@color/primary_light">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="@dimen/space_lg">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/garden_today_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/on_surface"
                                    android:textSize="@dimen/text_title_sm"
                                    android:fontFamily="sans-serif-medium"
                                    tools:text="Today, 8 May" />

                                <TextView
                                    android:id="@+id/garden_today_subtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:textColor="@color/on_surface_secondary"
                                    android:textSize="@dimen/text_body_sm"
                                    tools:text="3 tasks" />

                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@null"
                                app:tint="@color/on_surface_secondary" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Aggregate Lunar Calendar across every plant the user
                     owns — LunarCalendarView added here at runtime (see
                     GardenFragment.ensureLunarViewAttached). -->
                <FrameLayout
                    android:id="@+id/garden_lunar_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/garden_lunar_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_2xl"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_garden"
                        android:contentDescription="@null"
                        app:tint="@color/on_surface_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/garden_lunar_empty_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_title_sm"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/garden_lunar_empty_body"
                        android:textColor="@color/on_surface_secondary"
                        android:textSize="@dimen/text_body_sm"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- Empty state — the garden has no plants at all. Distinct from
                 "plants exist but no rooms yet", which renders inside the
                 Rooms pane instead (see GardenFragment.renderRooms). -->
            <LinearLayout
                android:id="@+id/garden_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_2xl"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:src="@drawable/illustration_empty_garden"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/empty_garden_title"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_headline"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/empty_garden_hint"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_empty_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/empty_garden_cta_add"
                    app:icon="@drawable/ic_garden"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/empty_garden_secondary_hint"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:gravity="center" />

                <!-- The Rooms pane (and its own "+ Add room" button) is
                     hidden entirely while the garden has no plants, which
                     left room creation with no reachable entry point at all
                     on a fresh install. Same string/icon/action as that
                     button, just reachable from here too. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/garden_empty_add_room"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/room_add"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Starts invisible: the FAB's final visibility (shown for a populated
         garden, hidden behind the empty-state CTA otherwise) isn't known
         until plants load. Revealing it only after the first render avoids
         the "Add plant" button flashing for a frame before the real state
         is committed. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/garden_add_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_xl"
        android:text="@string/add_plant"
        android:visibility="invisible"
        app:icon="@drawable/ic_garden" />

</FrameLayout>
