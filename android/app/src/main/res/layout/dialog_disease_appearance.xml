<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen transparent touch layer. Tapping outside the centred card
     dismisses the overlay; the card consumes its own touches. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appearance_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_disease_appearance"
        style="@style/App.GlassCard.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/content_gutter"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_appearance_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/example_photos_label"
                    android:textAppearance="@style/TextAppearance.App.Title" />

                <ImageButton
                    android:id="@+id/btn_close_appearance"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/close"
                    android:padding="@dimen/space_xs"
                    android:src="@drawable/ic_close"
                    app:tint="@color/on_surface_secondary" />

            </LinearLayout>

            <ImageView
                android:id="@+id/iv_disease_appearance"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_glass_card"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/description_label"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:id="@+id/tv_appearance_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_appearance_guide"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/result_learn_more"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
