<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery screen — staggered grid of past scans, with shimmer
     placeholder during initial load and a Lottie empty state. -->
<LinearLayout
    android:id="@+id/gallery_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Page title + clear-history action. Used to live in the shared
         MainActivity toolbar, pinned above the pager; that title only
         updated once a swipe settled, so it read as floating disconnected
         from the page sliding underneath it mid-drag. Living here instead,
         it's part of this page's own content and slides with it. The
         clear-history basket moves here too — it used to be a toolbar menu
         item scoped to this fragment's lifecycle, which only worked while
         the shared toolbar was visible on this tab. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/content_gutter"
        android:paddingTop="@dimen/space_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_gallery"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.01" />

        <ImageButton
            android:id="@+id/btn_clear_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/on_surface"
            android:contentDescription="@string/clear_history"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:chipSpacingHorizontal="@dimen/space_sm">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_all"
            android:checked="true"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:checkedIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_healthy"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_healthy"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:checkedIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_diseased"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_diseased"
            app:chipBackgroundColor="@color/chip_bg_color"
            app:checkedIconEnabled="false" />

    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_gallery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/space_sm" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/space_sm"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_color="@color/shimmer_base"
            app:shimmer_highlight_color="@color/shimmer_highlight"
            app:shimmer_duration="1200">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <View android:layout_width="0dp" android:layout_height="220dp"
                    android:layout_columnWeight="1" android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_glass_card" />
                <View android:layout_width="0dp" android:layout_height="220dp"
                    android:layout_columnWeight="1" android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_glass_card" />
                <View android:layout_width="0dp" android:layout_height="220dp"
                    android:layout_columnWeight="1" android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_glass_card" />
                <View android:layout_width="0dp" android:layout_height="220dp"
                    android:layout_columnWeight="1" android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_glass_card" />
                <View android:layout_width="0dp" android:layout_height="220dp"
                    android:layout_columnWeight="1" android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_glass_card" />
                <View android:layout_width="0dp" android:layout_height="220dp"
                    android:layout_columnWeight="1" android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_glass_card" />

            </GridLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/empty_state_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_empty"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:lottie_rawRes="@raw/empty_plants"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/empty_gallery"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_headline"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/empty_gallery_hint"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_first_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/first_scan_cta"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filter_empty_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_3xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_plant_placeholder"
                android:contentDescription="@string/empty_gallery"
                app:tint="@color/primary_variant" />

            <TextView
                android:id="@+id/tv_filter_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/filter_empty_hint"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
