<?xml version="1.0" encoding="utf-8"?>
<!-- One climate row of the care-plan details: icon, all-caps label, value.
     Icon, label and value are set when the plan binds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_care_plan_metric_chip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/care_plan_chip_padding_v"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/care_plan_chip_padding_v">

    <ImageView
        android:id="@+id/care_plan_chip_icon"
        android:layout_width="@dimen/care_plan_chip_icon"
        android:layout_height="@dimen/care_plan_chip_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:tint="@color/primary"
        tools:src="@drawable/ic_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/care_plan_chip_text_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/care_plan_chip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Caption"
            tools:text="LIGHT" />

        <TextView
            android:id="@+id/care_plan_chip_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/care_plan_chip_value_gap"
            android:textAppearance="@style/TextAppearance.App.CarePlan.ItemMedium"
            tools:text="1000-2500 lx" />
    </LinearLayout>
</LinearLayout>
