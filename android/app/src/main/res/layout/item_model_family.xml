<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="@dimen/space_md"
    android:minHeight="56dp">

    <!-- Decorative: the family name is announced by family_title. -->
    <ImageView
        android:id="@+id/family_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="@drawable/bg_circle_surface_variant"
        android:importantForAccessibility="no"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_md"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/family_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/family_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:background="@drawable/bg_pill_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/family_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/text_body_sm"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Decorative: selection is announced on the row itself via a state
         description set in ModelPickerSheet, so the check icon is silent to
         avoid a redundant "selected, check" double announcement. -->
    <ImageView
        android:id="@+id/family_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_sm"
        android:src="@drawable/ic_check"
        app:tint="?attr/colorPrimary"
        android:visibility="invisible"
        android:importantForAccessibility="no" />

</LinearLayout>
