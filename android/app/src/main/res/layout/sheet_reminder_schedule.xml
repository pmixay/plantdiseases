<?xml version="1.0" encoding="utf-8"?>
<!--
    Reminder schedule bottom sheet — generic-reminder edition. Drag
    handle, gradient header, then a scrollable list of the plant's
    reminders (item_reminder_row, bound in code) and an "Add reminder"
    button that opens the composer dialog (dialog_reminder_editor).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:background="@drawable/bg_hero_card"
        android:padding="@dimen/space_xl">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_care"
                android:contentDescription="@null"
                app:tint="@color/primary" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminders"
                android:textColor="@color/on_hero"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/reminder_plant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_hero_secondary"
                android:textSize="@dimen/text_body"
                tools:text="Monstera" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xxs"
        android:text="@string/reminder_subtitle"
        android:textColor="@color/on_surface_secondary"
        android:textSize="@dimen/text_body_sm" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm">

            <!-- Populated with item_reminder_row entries in code. -->
            <LinearLayout
                android:id="@+id/reminder_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/reminder_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/space_xl"
                android:gravity="center"
                android:text="@string/reminder_empty_list"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_add_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_2xl"
                android:minHeight="52dp"
                android:text="@string/reminder_add"
                app:icon="@drawable/ic_bell"
                app:iconGravity="textStart" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
