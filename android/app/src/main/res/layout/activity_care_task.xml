<?xml version="1.0" encoding="utf-8"?>
<!--
    Task detail — serves all three CareQueue.CareTask kinds (recurring
    occurrence, treatment step, one-off). Sections render only when they
    have content (see CareTaskActivity) — a watering task has no
    products/recommendations and must not show empty headers for them.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/care_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/care_task_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/care_task_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:title="">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="48dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/care_task_type_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/toolbar_title"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Обработка" />

                <TextView
                    android:id="@+id/care_task_time_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/on_hero_secondary"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="12:00" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/care_task_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_gutter"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_3xl">

            <!-- Plant chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_thumb_rounded"
                android:padding="@dimen/space_md">

                <ImageView
                    android:id="@+id/care_task_plant_thumb"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_thumb_rounded"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/care_task_plant_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Венерина мухоловка" />

                    <TextView
                        android:id="@+id/care_task_plant_step"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_secondary"
                        android:textSize="@dimen/text_body_sm"
                        android:visibility="gone"
                        tools:text="Шаг 2 из 5 · Фунгицид"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:id="@+id/care_task_description_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/task_description"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/care_task_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="3dp"
                    tools:text="Обработать растение препаратом от серой гнили (ботритис)." />

            </LinearLayout>

            <!-- What to do -->
            <LinearLayout
                android:id="@+id/care_task_bullets_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/task_what_to_do"
                    android:textColor="@color/on_surface" />

                <LinearLayout
                    android:id="@+id/care_task_bullets_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/space_xs" />

            </LinearLayout>

            <!-- Recommendations -->
            <LinearLayout
                android:id="@+id/care_task_recommendations_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/task_recommendations"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/care_task_best_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="Рано утром или вечером — не под прямым солнцем." />

                <TextView
                    android:id="@+id/care_task_temp_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="Температура воздуха: 15–26 °C" />

                <TextView
                    android:id="@+id/care_task_dry_hours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="Избегайте осадков в ближайшие 12 часов" />

            </LinearLayout>

            <!-- Recommended products -->
            <LinearLayout
                android:id="@+id/care_task_products_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/task_products"
                    android:textColor="@color/on_surface" />

                <LinearLayout
                    android:id="@+id/care_task_products_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/space_xs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/task_products_disclaimer"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- Completion history -->
            <LinearLayout
                android:id="@+id/care_task_history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/task_history"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/care_task_last_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="Последний раз: 5 мая" />

                <TextView
                    android:id="@+id/care_task_next_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:visibility="gone"
                    tools:text="Следующий шаг: 16 мая"
                    tools:visibility="visible" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/care_task_done_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/task_mark_done"
                app:icon="@drawable/ic_check" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
