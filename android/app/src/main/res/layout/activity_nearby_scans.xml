<?xml version="1.0" encoding="utf-8"?>
<!--
    "Scans near you" — a social-style vertical feed of community scans
    from the user's region. Opened from the camera screen's top-right
    community button. Each post links into the second-opinion sheet.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:title="@string/nearby_scans_title"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:titleTextColor="@color/toolbar_title" />

        <!-- Scope toggle: "Nearby" (~30 km) vs "Country" vs "Worldwide". -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingBottom="@dimen/space_sm"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_scope_nearby"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/community_filter_nearby" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_scope_country"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_filter_country" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_scope_worldwide"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_filter_worldwide" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Shared offline notice, pinned under the scope chips. The feed is
             live-only, so this says the connection is what's missing. -->
        <com.plantdiseases.app.ui.common.OfflineNoticeView
            android:id="@+id/offline_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline_notice_needs_connection" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_nearby"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_2xl"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Subtitle pinned at top while the feed scrolls underneath
                 would be nice, but a simple centered state keeps the
                 empty/loading flows unambiguous. -->
            <LinearLayout
                android:id="@+id/state_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_2xl">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary"
                    app:trackThickness="3dp" />

                <ImageView
                    android:id="@+id/iv_state_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_community"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:tint="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/tv_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/nearby_scans_loading"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_surface_secondary" />

                <!-- Shown only when community is OFF: in-context opt-in. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enable_community"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/community_enable_cta"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:icon="@drawable/ic_community"
                    app:cornerRadius="@dimen/radius_md" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
