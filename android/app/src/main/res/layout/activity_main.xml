<?xml version="1.0" encoding="utf-8"?>
<!-- Main shell — toolbar + bottom nav with the navigation host between.
     A vertical LinearLayout (not a CoordinatorLayout): the app bar has no
     scroll-collapse behaviour, and stacking the three children lets the app bar
     be hidden with View.GONE on the immersive Garden/Profile tabs (see
     MainActivity) so the nav host fills from the very top — a CoordinatorLayout
     left a residual ScrollingViewBehavior offset (white gap) when the app bar
     went GONE. The bottom nav uses our background tone so the surface still
     reads as "page" rather than a hard white strip. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@color/toolbar_title"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:popupTheme="@style/ThemeOverlay.Material3.Light" />

        <!-- Fixed seam under the bar. The tabs are ViewPager2 pages now, so
             they slide horizontally beneath this bar; a still hairline against
             the moving content is what tells the eye the bar itself is pinned
             (a drop shadow can't — it's invisible on the near-black surface).
             Inside the AppBarLayout so it vanishes with the bar on the
             hero-header tabs (Garden/Profile). -->
        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/toolbar_divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:clipToPadding="false"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemActiveIndicatorStyle="@style/App.BottomNavIndicator"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
