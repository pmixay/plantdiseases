<?xml version="1.0" encoding="utf-8"?>
<!--
    Contents of the universal species-info card (SpeciesInfoCardView).

    Deliberately minimal: a Wikipedia lead photo, the species name, the
    Wikipedia description, and a single "more about this species" action that
    opens the full species screen. Everything richer — care, toxicity,
    flowering, native range, common problems — lives on that screen, not here,
    so this card stays the same height wherever it is embedded.

    The description is capped at @integer/species_info_collapsed_lines and the
    toggle row below it is revealed only when the text actually overflows, so
    a two-sentence blurb never grows a pointless "show more".
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/species_info_photo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/species_info_photo_height"
            android:layout_marginBottom="@dimen/space_md"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_plant_placeholder" />

        <TextView
            android:id="@+id/species_info_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Monstera" />

        <!-- Hidden when the binomial is missing, or when it would just repeat
             the name above (common for species with no common name). -->
        <TextView
            android:id="@+id/species_info_scientific"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Monstera deliciosa"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/species_info_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="@integer/species_info_collapsed_lines"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Monstera deliciosa is a species of flowering plant native to tropical forests of southern Mexico, south to Panama."
            tools:visibility="visible" />

        <!-- Revealed by the view only when the description is actually clipped. -->
        <LinearLayout
            android:id="@+id/species_info_expand_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/species_info_touch_target"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/species_info_expand_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/species_info_expand"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/species_info_expand_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/species_info_more"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical|start"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:paddingStart="0dp"
            android:text="@string/species_info_more"
            android:visibility="gone"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="end"
            tools:visibility="visible" />
    </LinearLayout>
</merge>
