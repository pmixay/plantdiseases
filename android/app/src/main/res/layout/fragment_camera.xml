<?xml version="1.0" encoding="utf-8"?>
<!--
    Camera screen.

    Layout simplifications vs. the previous revision:
      • Root no longer paints solid black behind PreviewView (some
        devices fail to draw the camera surface over an opaque
        background, leaving a dark frame).
      • All over-the-preview HUD (flash button, hint, zoom badge,
        bottom panel) uses the new liquid-glass drawables so the
        controls always read as "frosted leaf glass" sitting on top
        of the live photo.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera Preview — fills the screen. Sits behind the bottom
         glass panel so the bottom-rounded glass reveals the leaf
         underneath through its translucent fill. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <!-- Grid overlay (rule of thirds) — toggled from profile -->
    <com.plantdiseases.app.ui.camera.GridOverlayView
        android:id="@+id/grid_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status-bar contrast scrim -->
    <View
        android:id="@+id/camera_scrim"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@color/camera_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Offline banner -->
    <TextView
        android:id="@+id/offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/disease_red"
        android:gravity="center"
        android:paddingVertical="@dimen/space_sm"
        android:text="@string/offline_banner"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body_sm"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shutter flash overlay -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0"
        android:elevation="20dp"
        android:visibility="gone" />

    <!-- Focus indicator -->
    <View
        android:id="@+id/focus_indicator"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/ic_focus_indicator"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Zoom indicator (frosted-glass pill) -->
    <TextView
        android:id="@+id/tv_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_glass_dark_pill"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_xs"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body_sm"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controls_panel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2.0×" />

    <!-- Scan hint pill — sits low so it doesn't fight the leaf framing -->
    <TextView
        android:id="@+id/tv_scan_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_2xl"
        android:text="@string/scan_hint"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_title_sm"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_glass_dark_pill"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingVertical="@dimen/space_sm"
        app:layout_constraintBottom_toTopOf="@id/controls_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Flash button — circular liquid-glass -->
    <ImageButton
        android:id="@+id/btn_flash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/space_lg"
        android:background="@drawable/bg_circle_semi"
        android:src="@drawable/ic_flash_off"
        android:scaleType="center"
        android:contentDescription="@string/flash"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@android:color/white" />

    <!-- Permission layout -->
    <LinearLayout
        android:id="@+id/permission_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls_panel">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_camera_permission"
            android:contentDescription="@string/camera_permission_needed"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/camera_permission_needed"
            android:textSize="@dimen/text_title_sm"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/grant_permission"
            app:cornerRadius="@dimen/radius_md" />

    </LinearLayout>

    <!-- Bottom controls — frosted-leaf-glass panel -->
    <LinearLayout
        android:id="@+id/controls_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_panel"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_md"
        android:elevation="@dimen/glass_elevation"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Recent scans horizontal strip -->
        <LinearLayout
            android:id="@+id/recent_scans_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/recent_scans"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body_sm"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_scans"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_lg"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

        <!-- Capture / Gallery row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Gallery button — glass circle -->
            <ImageButton
                android:id="@+id/btn_gallery"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/space_4xl"
                android:background="@drawable/bg_glass_circle"
                android:src="@drawable/ic_gallery"
                android:scaleType="center"
                android:contentDescription="@string/gallery"
                app:tint="@color/on_surface" />

            <!-- Capture button — primary green leaf shutter -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_scan"
                android:contentDescription="@string/take_photo"
                app:fabSize="auto"
                app:fabCustomSize="72dp"
                app:maxImageSize="36dp"
                app:backgroundTint="@color/primary"
                app:tint="@color/on_primary"
                app:elevation="@dimen/glass_elevation"
                app:borderWidth="0dp" />

            <!-- Spacer keeps the capture button optically centered -->
            <Space
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/space_4xl" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
