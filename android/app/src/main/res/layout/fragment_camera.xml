<?xml version="1.0" encoding="utf-8"?>
<!--
    Camera screen.

    Material 3 flat surfaces — no translucent glass effects. The bottom
    panel sits on ``surface`` with a soft top shadow, and on-preview
    controls (flash, focus, zoom badge) use plain dark scrims so they
    stay readable on bright leaves without competing with the live
    image. The shutter is the single capture trigger.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera preview — fills the screen. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <!-- Grid overlay (rule of thirds) — toggled from profile. -->
    <com.plantdiseases.app.ui.camera.GridOverlayView
        android:id="@+id/grid_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shared offline notice. CameraFragment observes the app-wide
         reachability state except when hosted by SpeciesIdentifyActivity,
         which owns the single notice for that screen. The message is set at
         runtime (see applyOfflineScanState): with the on-device model
         installed an offline scan still works, just limited. -->
    <com.plantdiseases.app.ui.common.OfflineNoticeView
        android:id="@+id/offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_notice_scan_unavailable"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Model-family picker pill: family icon, the active model's name and a
         dropdown chevron. Opens the picker bottom sheet. -->
    <LinearLayout
        android:id="@+id/btn_model_family"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_md"
        android:background="@drawable/bg_model_picker_pill"
        android:clickable="true"
        android:contentDescription="@string/model_family_cd"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/offline_banner">

        <ImageView
            android:id="@+id/iv_model_family_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_family_gamma"
            app:tint="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/tv_model_family"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:text="@string/model_family_gamma"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="@dimen/text_body_sm" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_xs"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/colorOnSecondaryContainer" />
    </LinearLayout>

    <!-- Shutter flash overlay. -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0"
        android:elevation="20dp"
        android:visibility="gone" />

    <!-- Tap-to-focus reticle. -->
    <View
        android:id="@+id/focus_indicator"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/ic_focus_indicator"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Zoom badge. -->
    <TextView
        android:id="@+id/tv_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_camera_pill"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_xs"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body_sm"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controls_panel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2.0×" />

    <!-- Camera permission empty state. -->
    <LinearLayout
        android:id="@+id/permission_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls_panel">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_camera_permission"
            android:contentDescription="@string/camera_permission_needed"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/camera_permission_needed"
            android:textSize="@dimen/text_title_sm"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/grant_permission"
            app:cornerRadius="@dimen/radius_md" />

    </LinearLayout>

    <!-- Bottom controls panel — clean opaque surface, rounded top. -->
    <LinearLayout
        android:id="@+id/controls_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_camera_panel"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_md"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Capture / Gallery row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_2xl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gallery"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:contentDescription="@string/gallery"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="28dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Shutter. No busy indicator: the cropper opens straight after
                 the capture is written. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btn_capture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avd_shutter_iris"
                    android:contentDescription="@string/take_photo"
                    app:fabSize="auto"
                    app:fabCustomSize="72dp"
                    app:maxImageSize="36dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:tint="?attr/colorOnPrimary"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:hoveredFocusedTranslationZ="0dp"
                    app:borderWidth="0dp" />

            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Flash toggle — mirrors the gallery button on the right so
                 the shutter stays optically centered. Kept ``invisible``
                 (not gone) when the camera has no flash unit so the row
                 balance never shifts. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_flash"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:contentDescription="@string/flash"
                android:visibility="invisible"
                app:icon="@drawable/ic_flash_off"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
