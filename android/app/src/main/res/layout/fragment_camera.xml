<?xml version="1.0" encoding="utf-8"?>
<!--
    Camera screen.

    Material 3 flat surfaces — no translucent glass effects. The bottom
    panel sits on ``surface`` with a soft top shadow, and on-preview
    controls (flash, focus, zoom badge) use plain dark scrims so they
    stay readable on bright leaves without competing with the live
    image. The shutter is the single capture trigger.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera preview — fills the screen. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <!-- Grid overlay (rule of thirds) — toggled from profile. -->
    <com.plantdiseases.app.ui.camera.GridOverlayView
        android:id="@+id/grid_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top scrim keeps system bar legible over bright frames. -->
    <View
        android:id="@+id/camera_scrim"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@color/camera_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Offline banner. -->
    <TextView
        android:id="@+id/offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/disease_red"
        android:gravity="center"
        android:paddingVertical="@dimen/space_sm"
        android:text="@string/offline_banner"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body_sm"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shutter flash overlay. -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0"
        android:elevation="20dp"
        android:visibility="gone" />

    <!-- Tap-to-focus reticle. -->
    <View
        android:id="@+id/focus_indicator"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/ic_focus_indicator"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Zoom badge. -->
    <TextView
        android:id="@+id/tv_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_camera_pill"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_xs"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_body_sm"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controls_panel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2.0×" />

    <!-- Flash toggle. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_flash"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/space_lg"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/flash"
        android:visibility="gone"
        app:icon="@drawable/ic_flash_off"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:backgroundTint="@color/camera_control_scrim"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Camera permission empty state. -->
    <LinearLayout
        android:id="@+id/permission_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls_panel">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_camera_permission"
            android:contentDescription="@string/camera_permission_needed"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/camera_permission_needed"
            android:textSize="@dimen/text_title_sm"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/grant_permission"
            app:cornerRadius="@dimen/radius_md" />

    </LinearLayout>

    <!-- Bottom controls panel — clean opaque surface, rounded top. -->
    <LinearLayout
        android:id="@+id/controls_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_camera_panel"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_md"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Recent scans strip. -->
        <LinearLayout
            android:id="@+id/recent_scans_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/recent_scans"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_body_sm"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_scans"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_lg"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

        <!-- Capture / Gallery row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_2xl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gallery"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/gallery"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="28dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_scan"
                android:contentDescription="@string/take_photo"
                app:fabSize="auto"
                app:fabCustomSize="72dp"
                app:maxImageSize="36dp"
                app:backgroundTint="?attr/colorPrimary"
                app:tint="?attr/colorOnPrimary"
                app:elevation="6dp"
                app:borderWidth="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Spacer column mirrors the gallery button so the shutter
                 stays optically centered. -->
            <Space
                android:layout_width="56dp"
                android:layout_height="56dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
