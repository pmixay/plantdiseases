<?xml version="1.0" encoding="utf-8"?>
<!--
    Privacy policy as native views. The text is not in this layout or in
    strings.xml: PrivacyPolicyActivity parses assets/privacy_policy.html and
    fills @+id/policy_content. Same toolbar/inset pattern as
    NotificationsActivity.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:title="@string/privacy_policy_title"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:titleTextColor="@color/toolbar_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/policy_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_gutter">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/language_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_ru"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_lang_ru"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    app:checkedIconEnabled="false"
                    app:chipBackgroundColor="@color/chip_bg_color" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_en"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_lang_en"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    app:checkedIconEnabled="false"
                    app:chipBackgroundColor="@color/chip_bg_color" />

            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:id="@+id/policy_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
