<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:title="@string/forum_helper_profile"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:titleTextColor="@color/toolbar_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <!-- Header: the member's level, leaves and helper stats on the
                     page background (no coloured block). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <TextView
                                android:id="@+id/tv_avatar"
                                style="@style/Forum.Avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:textSize="22sp" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_avatar_photo"
                                style="@style/Forum.AvatarPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_nickname"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="-0.01"
                                android:maxLines="1"
                                android:textColor="@color/on_surface"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tv_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_forum_badge"
                                android:backgroundTint="@color/primary_light"
                                android:drawablePadding="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/forum_text_meta"
                                app:drawableStartCompat="@drawable/ic_leaf"
                                app:drawableTint="@color/primary" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pb_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:max="100"
                        app:indicatorColor="@color/primary"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="@color/primary_light"
                        app:trackCornerRadius="4dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tv_next_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="2"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/forum_text_meta" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_stat_accepted"
                            style="@style/Forum.StatTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_stat_saved"
                            style="@style/Forum.StatTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_stat_taught"
                            style="@style/Forum.StatTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_discount"
                    style="@style/App.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/warning_amber_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_discount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_sm"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/text_title_sm"
                            app:drawableStartCompat="@drawable/ic_trophy"
                            app:drawableTint="@color/warning_amber" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pb_discount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:max="40"
                            app:indicatorColor="@color/warning_amber"
                            app:trackCornerRadius="3dp" />

                        <TextView
                            android:id="@+id/tv_discount_detail"
                            style="@style/Forum.Meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="3" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_achievements_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:textAppearance="@style/TextAppearance.App.Title" />

                <!-- Cards carry 5dp margins; -5dp here lines their edges up
                     with the header. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_achievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-5dp"
                    android:layout_marginTop="@dimen/space_xs"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:textColor="@color/on_surface"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
