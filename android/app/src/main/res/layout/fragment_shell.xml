<?xml version="1.0" encoding="utf-8"?>
<!-- The five bottom-nav tabs as pages on one horizontal axis. Nothing else
     lives here: the toolbar and the bottom bar stay in activity_main.xml,
     outside the pager, so they don't slide with the pages and so they survive
     the guide being pushed on top of this fragment. -->
<androidx.viewpager2.widget.ViewPager2
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_pager"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
