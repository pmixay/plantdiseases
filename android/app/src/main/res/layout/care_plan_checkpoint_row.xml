<?xml version="1.0" encoding="utf-8"?>
<!-- One checkpoint of the care-plan timeline: a green day badge and its check. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/care_plan_row_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/care_plan_checkpoint_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_care_plan_badge"
        android:gravity="center"
        android:minWidth="@dimen/care_plan_badge_min_width"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/care_plan_badge_padding_v"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/care_plan_badge_padding_v"
        android:textAppearance="@style/TextAppearance.App.CarePlan.BodySm"
        android:textColor="@color/on_primary"
        android:fontFamily="sans-serif-medium"
        tools:text="D3" />

    <TextView
        android:id="@+id/care_plan_checkpoint_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:lineSpacingExtra="@dimen/care_plan_line_extra"
        android:textAppearance="@style/TextAppearance.App.CarePlan.Item"
        tools:text="Check the new growth" />
</LinearLayout>
