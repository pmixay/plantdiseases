<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery grid card. Frosted-glass surface, photo at the top with a
     status accent strip, two-line caption underneath. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/glass_elevation_soft"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_plant"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/result_title" />

            <View
                android:id="@+id/status_indicator"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom" />

            <!-- Community activity badge (opinions · views) on shared scans;
                 set + shown from GalleryAdapter, hidden when there's none. -->
            <TextView
                android:id="@+id/tv_community_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/bg_glass_dark_pill"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:textSize="@dimen/text_caption"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <!-- Red "+N" badge for opinions the user hasn't viewed yet. -->
            <TextView
                android:id="@+id/tv_new_opinions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/bg_badge_new"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="2dp"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/tv_disease_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_confidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/on_surface_secondary"
                    android:alpha="0.7" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
