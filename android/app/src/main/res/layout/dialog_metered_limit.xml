<?xml version="1.0" encoding="utf-8"?>
<!-- Daily cloud limit / unavailable-feature dialog (MeteredAccessUi): an icon
     in a circle, the title, one short line, and when the allowance comes back.
     No "0 left" count: the title already says it is used up. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_2xl"
    android:paddingTop="@dimen/space_2xl"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/iv_metered_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_metered_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_metered_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:lineSpacingExtra="2sp"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_body" />

    <LinearLayout
        android:id="@+id/metered_reset_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/bg_stat_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tv_metered_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
