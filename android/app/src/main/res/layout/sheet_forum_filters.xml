<?xml version="1.0" encoding="utf-8"?>
<!-- Community feed filters: what to show, which space, and the order.
     Applied together with "Show posts"; CommunityFragment.showFilters(). -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_2xl">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forum_filters"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forum_filters_show"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_body_sm" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_show_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_tab_all"
                app:checkedIconEnabled="false"
                app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_show_needs_help"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_tab_needs_help"
                app:checkedIconEnabled="false"
                app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_show_solved"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_tab_solved"
                app:checkedIconEnabled="false"
                app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_show_mine"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_tab_mine"
                app:checkedIconEnabled="false"
                app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forum_spaces"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_body_sm" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <LinearLayout
            android:id="@+id/sort_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:fontFamily="sans-serif-medium"
                android:text="@string/forum_filters_sort"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_hot"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forum_sort_hot"
                    app:checkedIconEnabled="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_new"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forum_sort_new"
                    app:checkedIconEnabled="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_top"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forum_sort_top"
                    app:checkedIconEnabled="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                app:chipStrokeColor="@color/forum_chip_stroke"
                android:textColor="@color/forum_chip_text" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_filters_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/forum_filters_apply" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
