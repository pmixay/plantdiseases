<?xml version="1.0" encoding="utf-8"?>
<!--
    A shared community scan (CommunityScanSheet): the photo, the model's
    diagnosis and confidence, the species card, the like control, and report
    and block for another member's scan. Opened from the map, profiles, the
    result screen's nearby scans and the species page.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_2xl">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_handle" />

        <!-- The shared scan photo, full sheet width and the tallest element on
             the sheet — it's the subject, not an aside. The CARD is shown/hidden
             programmatically; hidden when this scan has no thumbnail. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_scan_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="@dimen/glass_stroke_width"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_scan_photo"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:contentDescription="@string/community_scan_photo_desc"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Current diagnosis block — styled like the scan-result status card
             (icon + ALLCAPS label + verdict + confidence/species line) so the
             sheet mirrors a real result. Set programmatically; hidden if
             unknown. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_scan_current"
            style="@style/App.GlassCard.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_disease"
                    app:tint="@color/on_surface_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_scan_diagnosis_label"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tv_scan_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/on_surface"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Leaf Spot" />

                    <!-- Model's read: confidence only. The species belongs to
                         the species card below, not to this line. -->
                    <TextView
                        android:id="@+id/tv_scan_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface"
                        android:visibility="gone"
                        tools:text="Confidence 87%"
                        tools:visibility="visible" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- The species this scan is of. Hidden when the upload carried no
             PlantNet binomial (CommunityScanItem.species is nullable — servers
             without a PlantNet key never populate it), so the card never
             becomes a dead-end tap. -->
        <com.plantdiseases.app.ui.common.SpeciesInfoCardView
            android:id="@+id/card_scan_species"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone" />

        <!-- Safety actions on another member's scan (hidden for guests and for
             the user's own scan).
             The server resolves the author from this scan's opaque token; the
             client never receives or submits an account id. -->
        <LinearLayout
            android:id="@+id/ll_community_scan_safety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_community_report_scan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_report_content"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_community_block_scan_author"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_block_author"
                android:textAllCaps="false"
                android:textColor="@color/disease_red" />

        </LinearLayout>

        <!-- Like control: a tonal pill
             with a 48dp touch target; locked (gray) for guests. -->
        <LinearLayout
            android:id="@+id/ll_scan_like"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginStart="@dimen/space_lg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_scan_like_pill"
            android:foreground="?attr/selectableItemBackground"
            android:clipToOutline="true"
            android:paddingHorizontal="@dimen/space_md"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_scan_like"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/community_like_action"
                android:src="@drawable/ic_heart"
                app:tint="@color/on_surface_secondary" />

            <TextView
                android:id="@+id/tv_scan_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:textSize="@dimen/text_body_sm"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_surface"
                tools:text="14" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
