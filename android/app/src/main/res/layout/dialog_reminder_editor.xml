<?xml version="1.0" encoding="utf-8"?>
<!--
    Generic-reminder composer dialog (add / edit). Name + optional
    description, single-select preset icon grid (filled in code from
    ReminderPresets), interval-days picker and time pickers. Hosted in
    a MaterialAlertDialog by ReminderScheduleSheet.showEditor.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xs">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editor_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/reminder_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editor_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/reminder_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editor_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/reminder_icon_label"
            android:textColor="@color/on_surface_secondary"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:textAllCaps="true" />

        <!-- Preset icon strip — one cell per ReminderPresets entry,
             built in code (single select). A horizontal scroller so all
             12 presets stay reachable on narrow screens; the two-row
             GridLayout previously clipped the later icons. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/editor_icon_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/editor_interval_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body_sm"
                tools:text="Every 7 days" />

            <NumberPicker
                android:id="@+id/editor_interval"
                android:layout_width="80dp"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/editor_time_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body_sm"
                tools:text="At 09:00" />

            <NumberPicker
                android:id="@+id/editor_hour"
                android:layout_width="70dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_xs"
                android:text=":"
                android:textColor="@color/on_surface_secondary"
                android:textSize="18sp" />

            <NumberPicker
                android:id="@+id/editor_minute"
                android:layout_width="70dp"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
