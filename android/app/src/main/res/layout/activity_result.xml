<?xml version="1.0" encoding="utf-8"?>
<!--
    Result screen.

    Refactor notes:
      • Every diagnostic card uses the new App.GlassCard / *.Strong
        styles — unified corner radius, padding and translucent green
        tint.
      • Skeleton placeholders are wrapped in a ShimmerFrameLayout so
        the perceived load no longer feels frozen.
      • Spacing constants (@dimen/space_*) replace the previous mix
        of 8/12/14/16dp magic numbers.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@drawable/bg_toolbar_gradient"
            app:expandedTitleGravity="bottom"
            app:expandedTitleMarginStart="@dimen/space_lg"
            app:expandedTitleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:collapsedTitleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:expandedTitleTextColor="@color/toolbar_title"
            app:collapsedTitleTextColor="@color/toolbar_title">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@color/toolbar_title"
                app:title="@string/result_title"
                app:titleTextColor="@color/toolbar_title" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Sticky header — frosted glass, slides in once the user scrolls
         past the hero card. -->
    <LinearLayout
        android:id="@+id/sticky_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm"
        android:background="@drawable/bg_glass_card_strong"
        android:elevation="@dimen/glass_elevation"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/tv_sticky_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_title_sm"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_sticky_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Skeleton loading state — wrapped in shimmer for life signal -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/skeleton_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/space_lg"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/shimmer_base"
        app:shimmer_highlight_color="@color/shimmer_highlight"
        app:shimmer_duration="1200">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_glass_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_glass_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_glass_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_glass_card" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Plant image with heatmap overlay -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/glass_elevation_soft">

                <FrameLayout
                    android:id="@+id/image_frame"
                    android:layout_width="match_parent"
                    android:layout_height="260dp">

                    <ImageView
                        android:id="@+id/iv_plant"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/result_title" />

                    <com.plantdiseases.app.ui.result.HeatmapOverlayView
                        android:id="@+id/heatmap_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0" />

                    <!-- Heatmap badge (frosted-glass on the photo) -->
                    <TextView
                        android:id="@+id/tv_heatmap_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/heatmap_label"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_glass_dark_pill"
                        android:paddingHorizontal="@dimen/space_md"
                        android:paddingVertical="@dimen/space_xs"
                        android:visibility="gone" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Combined Status + Confidence + Date — primary glass card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                style="@style/App.GlassCard.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_status_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/status_healthy" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_status_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body_sm"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tv_disease_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="22sp"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Confidence row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confidence_label"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/on_surface_secondary" />

                        <TextView
                            android:id="@+id/tv_confidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/primary"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/primary_light"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <!-- Date row -->
                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Description -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_description"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/description_label"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Treatment / Prevention tabs card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_treatment_prevention"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabs_treatment_prevention"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:tabMode="fixed"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/primary"
                        app:tabIndicatorHeight="3dp"
                        app:tabSelectedTextColor="@color/primary"
                        app:tabTextColor="@color/on_surface_secondary" />

                    <LinearLayout
                        android:id="@+id/treatment_steps_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg" />

                    <LinearLayout
                        android:id="@+id/prevention_steps_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Top-3 alternative diagnoses — explainable AI -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_alternatives"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/why_this_diagnosis"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/alternatives_subtitle"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <LinearLayout
                        android:id="@+id/alternatives_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Auto-detected species (server-side PlantNet fan-out).
                 Hidden when the analyze response carries no species
                 block. The card surfaces the best match + up to 2
                 alternates so the user can pick a different species
                 if PlantNet's top guess is off. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_species"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_scan"
                            android:contentDescription="@null"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/species_card_title"
                            android:textAppearance="@style/TextAppearance.App.Title" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_species_best"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textSize="@dimen/text_title_sm"
                        android:textColor="@color/on_surface"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_species_scientific"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/tv_species_score"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/primary" />

                    <LinearLayout
                        android:id="@+id/species_alts_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- "Similar scans near you" — server-side community corpus.
                 Renders a header, a "top diseases" chip row built from
                 the regional summary, an empty-state hint, and a
                 horizontal carousel of the most recent diagnoses in
                 the same region. Each thumbnail loads via
                 /api/community/thumb/<filename> from ServerConfig
                 .baseUrl. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_similar_scans"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_garden"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/similar_scans_title"
                            android:textAppearance="@style/TextAppearance.App.Title" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_similar_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Top diseases in the region — empty when summary
                         arrives with no entries (rare for non-empty
                         corpora). -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_top_diseases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        app:singleLine="false"
                        app:chipSpacingHorizontal="@dimen/space_xs"
                        app:chipSpacingVertical="@dimen/space_xs"
                        android:visibility="gone" />

                    <!-- Empty state shown when the region has no recent
                         scans yet. Keeps the card on screen so the user
                         understands the feature exists. -->
                    <TextView
                        android:id="@+id/tv_similar_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center"
                        android:padding="@dimen/space_lg"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_similar_scans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:clipToPadding="false"
                        android:paddingEnd="@dimen/space_md" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Pipeline warnings (uncertain healthy / detector mismatch) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pipeline_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/warning_amber_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_warning"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_pipeline_warning_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/warning_amber" />

                        <TextView
                            android:id="@+id/tv_pipeline_warning_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/warning_amber"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Pet-toxicity card. Server populates `toxic_to_pets`,
                 `toxic_species_list` and `toxicity_source`. UI surfaces:
                   • "Toxic to cats / dogs / horses" pill when source=db.
                   • "Pet safety unconfirmed" hint when source=unknown so
                     we never falsely reassure on an un-identified plant. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_toxicity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:id="@+id/iv_toxicity_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_warning"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_toxicity_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_toxicity_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/on_surface_secondary"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Diagnosis feedback (thumbs up / thumbs down + corrected
                 class + free text). POSTed to /api/feedback. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_feedback"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_feedback_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/feedback_subtitle"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <LinearLayout
                        android:id="@+id/feedback_choice_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback_yes"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:minHeight="48dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingHorizontal="@dimen/space_md"
                            android:text="@string/feedback_yes"
                            android:textColor="@color/on_primary"
                            app:backgroundTint="@color/primary"
                            app:icon="@drawable/ic_healthy"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/on_primary"
                            app:cornerRadius="@dimen/radius_md"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback_no"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingHorizontal="@dimen/space_md"
                            android:text="@string/feedback_no"
                            android:textColor="@color/on_surface"
                            app:icon="@drawable/ic_warning"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/on_surface_secondary"
                            app:cornerRadius="@dimen/radius_md"
                            android:textAllCaps="false" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_feedback_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:visibility="gone"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Low confidence warning -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_low_confidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/warning_amber_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_warning"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:text="@string/low_confidence_warning"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/warning_amber" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry_analysis"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/retry_analysis"
                        android:textColor="@color/warning_amber"
                        app:icon="@drawable/ic_scan"
                        app:iconTint="@color/warning_amber" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action bar — frosted leaf-glass over the page. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_glass_card_strong"
        app:cardCornerRadius="0dp"
        app:cardElevation="@dimen/glass_elevation"
        app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="@dimen/space_sm"
            android:paddingHorizontal="@dimen/space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_to_garden"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.7"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/add_to_garden"
                android:maxLines="1"
                android:ellipsize="end"
                app:icon="@drawable/ic_garden"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_xs"
                app:cornerRadius="@dimen/radius_md"
                app:backgroundTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_scan"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.0"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/new_scan"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/radius_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/share"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/primary"
                app:cornerRadius="@dimen/radius_md" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
