<?xml version="1.0" encoding="utf-8"?>
<!--
    Result screen.

    Refactor notes:
      • Every diagnostic card uses the new App.GlassCard / *.Strong
        styles — unified corner radius, padding and translucent green
        tint.
      • Skeleton placeholders are wrapped in a ShimmerFrameLayout so
        the perceived load no longer feels frozen.
      • Spacing constants (@dimen/space_*) replace the previous mix
        of 8/12/14/16dp magic numbers.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Adaptive header: green gradient in light theme, flat surface in dark
         (the gradient drawable is overridden in drawable-night). toolbar_title
         is theme-aware so it stays legible on both. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@drawable/bg_toolbar_gradient"
            app:expandedTitleGravity="bottom"
            app:expandedTitleMarginStart="@dimen/space_lg"
            app:expandedTitleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:collapsedTitleTextAppearance="@style/TextAppearance.App.Toolbar"
            app:expandedTitleTextColor="@color/toolbar_title"
            app:collapsedTitleTextColor="@color/toolbar_title">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@color/toolbar_title"
                app:title="@string/result_title"
                app:titleTextColor="@color/toolbar_title" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Sticky header — frosted glass, slides in once the user scrolls
         past the hero card. -->
    <LinearLayout
        android:id="@+id/sticky_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/content_gutter"
        android:paddingVertical="@dimen/space_sm"
        android:background="@drawable/bg_glass_card_strong"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/tv_sticky_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_title_sm"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_sticky_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Skeleton loading state — wrapped in shimmer for life signal -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/skeleton_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/content_gutter"
        android:paddingVertical="@dimen/space_lg"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/shimmer_base"
        app:shimmer_highlight_color="@color/shimmer_highlight"
        app:shimmer_duration="1200">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_glass_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_glass_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_glass_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_glass_card" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_gutter"
            android:paddingVertical="@dimen/space_lg">

            <!-- Plant image with heatmap overlay -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/glass_elevation_soft">

                <FrameLayout
                    android:id="@+id/image_frame"
                    android:layout_width="match_parent"
                    android:layout_height="260dp">

                    <!-- The scanned photo is decorative for TalkBack; the
                         diagnosis is announced by the status/label text below.
                         (Was a static, misleading "Diagnosis" label.) -->
                    <ImageView
                        android:id="@+id/iv_plant"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <com.plantdiseases.app.ui.result.HeatmapOverlayView
                        android:id="@+id/heatmap_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0" />

                    <!-- Heatmap badge (frosted-glass on the photo) -->
                    <TextView
                        android:id="@+id/tv_heatmap_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/heatmap_label"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_glass_dark_pill"
                        android:paddingHorizontal="@dimen/space_md"
                        android:paddingVertical="@dimen/space_xs"
                        android:visibility="gone" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Combined Status + Confidence + Date — primary glass card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                style="@style/App.GlassCard.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:contentPadding="0dp"
                android:foreground="?attr/selectableItemBackground">

                <!-- The gradient layer is only enabled for uncertain verdicts.
                     It keeps the confidence advisory visually part of this
                     card instead of creating a second warning card below it. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:id="@+id/status_confidence_gradient"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_status_low_confidence"
                        android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <!-- Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Decorative: the icon's image swaps per verdict in
                             code but its contentDescription never did, so it
                             announced "Healthy" even on disease / not-a-plant.
                             tv_status_label announces the real verdict. -->
                        <ImageView
                            android:id="@+id/iv_status_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:id="@+id/disease_status_text_column"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_status_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textSize="@dimen/text_body_sm"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_disease_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="-0.01"
                                    android:maxLines="1"
                                    android:maxWidth="240dp"
                                    android:textSize="18sp"
                                    android:textColor="@color/on_surface"
                                    android:fontFamily="sans-serif-medium"
                                    android:accessibilityHeading="true" />

                                <ImageButton
                                    android:id="@+id/btn_disease_appearance"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/bg_disease_appearance_button"
                                    android:contentDescription="@string/example_photos_label"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:padding="3dp"
                                    android:src="@drawable/ic_question"
                                    android:translationY="-1dp"
                                    android:visibility="gone" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Confidence row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confidence_label"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/on_surface_secondary" />

                        <TextView
                            android:id="@+id/tv_confidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/primary"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/primary_light"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <!-- Date row -->
                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <!-- One compact, actionable confidence advisory. It is
                         deliberately in the verdict card so uncertain scans
                         don't show a duplicated stack of yellow warning cards. -->
                    <LinearLayout
                        android:id="@+id/inline_confidence_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_warning"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tv_inline_confidence_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/warning_amber"
                                android:textSize="@dimen/text_body" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_inline_confidence_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/on_surface_secondary"
                            android:textSize="@dimen/text_body_sm"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                    <!-- Community action stays at the bottom of the verdict
                         card, aligned with the card's other content. -->
                    <LinearLayout
                        android:id="@+id/status_action_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_second_opinion"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:maxLines="2"
                            android:minWidth="0dp"
                            android:paddingStart="0dp"
                            android:textSize="@dimen/text_body_sm"
                            android:visibility="gone"
                            android:text="@string/result_get_second_opinion"
                            app:icon="@drawable/ic_community"
                            app:iconGravity="textStart"
                            app:iconSize="20dp" />

                    </LinearLayout>

                </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Universal species card. It is the first follow-up to the
                 diagnosis: identity is more useful here than a long care
                 section. The controller hides it when no species was found. -->
            <com.plantdiseases.app.ui.common.SpeciesInfoCardView
                android:id="@+id/card_species"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone" />

            <!-- Non-confidence pipeline advisories that need their own context
                 (for example, an offline scan or blurry image). Confidence
                 itself is rendered inside the status card above. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pipeline_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/warning_amber_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_warning"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_pipeline_warning_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/warning_amber" />

                        <TextView
                            android:id="@+id/tv_pipeline_warning_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/warning_amber"
                            android:lineSpacingExtra="2dp" />

                        <!-- Shown only for offline (Aqua) scans: re-run the same
                             photo through the full online model to upgrade it. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_improve_online"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-8dp"
                            android:layout_marginTop="@dimen/space_xs"
                            android:visibility="gone"
                            android:text="@string/improve_online"
                            android:textColor="@color/warning_amber"
                            app:icon="@drawable/ic_scan"
                            app:iconTint="@color/warning_amber" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AI Plant Doctor remains available without bringing back the
                 removed Treatment / Prevention tabs card. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ask_doctor"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="48dp"
                android:text="@string/doctor_open_cta"
                android:visibility="gone"
                app:icon="@drawable/ic_doctor_chat"
                app:iconGravity="textStart"
                app:cornerRadius="@dimen/radius_md" />

            <!-- Description -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_description"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/description_label"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Similar scans: server-side community corpus.
                 Renders a header, a "top diseases" chip row built from
                 the server summary, an empty-state hint, and a
                 horizontal carousel of the most recent diagnoses in
                 the same server-selected scope. Each thumbnail loads via
                 /api/community/thumb/<filename> from ServerConfig
                 .baseUrl. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_similar_scans"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_garden"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/similar_scans_title"
                            android:textAppearance="@style/TextAppearance.App.Title" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_similar_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Empty state shown when the region has no recent
                         scans yet. Keeps the card on screen so the user
                         understands the feature exists. -->
                    <TextView
                        android:id="@+id/tv_similar_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center"
                        android:padding="@dimen/space_lg"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_similar_scans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:clipToPadding="false"
                        android:paddingEnd="@dimen/space_md" />

                    <!-- In-context opt-in: shown only when community is OFF.
                         Tapping enables community + requests coarse location,
                         then the card loads the nearby feed. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enable_similar"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/community_enable_cta"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        app:icon="@drawable/ic_garden"
                        app:cornerRadius="@dimen/radius_md" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Top-3 alternative diagnoses — explainable AI. This is kept at
                 the bottom of the result, immediately before feedback. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_alternatives"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/why_this_diagnosis"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/alternatives_subtitle"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <LinearLayout
                        android:id="@+id/alternatives_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Diagnosis feedback (thumbs up / thumbs down + corrected
                 class + free text). POSTed to /api/feedback. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_feedback"
                style="@style/App.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_feedback_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/feedback_subtitle"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <LinearLayout
                        android:id="@+id/feedback_choice_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback_yes"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:minHeight="48dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingHorizontal="@dimen/space_md"
                            android:text="@string/feedback_yes"
                            android:textColor="@color/on_primary"
                            app:backgroundTint="@color/primary"
                            app:icon="@drawable/ic_healthy"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/on_primary"
                            app:cornerRadius="@dimen/radius_md"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback_no"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingHorizontal="@dimen/space_md"
                            android:text="@string/feedback_no"
                            android:textColor="@color/on_surface"
                            app:icon="@drawable/ic_warning"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/on_surface_secondary"
                            app:cornerRadius="@dimen/radius_md"
                            android:textAllCaps="false" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_feedback_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:visibility="gone"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- No-photo fallback: shown when the verdict is not_a_plant or
                 low-confidence, so the user can still get guidance by
                 answering a few symptom questions. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_symptom_checker"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                android:text="@string/symptom_checker_entry_title"
                app:icon="@drawable/ic_care"
                app:iconGravity="textStart" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action bar — flat surface with a hairline top divider.
         Kept as a MaterialCardView so ResultActivity.setContentPadding can
         apply the nav-bar bottom inset; no android:background drawable and
         no stroke (the old rounded-bg-in-a-square-card combo drew the ugly
         seam). colorSurface + a 1dp top divider reads clean in light + dark. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="@dimen/space_md"
                android:paddingHorizontal="@dimen/content_gutter">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_to_garden"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.7"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:text="@string/add_to_garden"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_garden"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_xs"
                    app:cornerRadius="@dimen/radius_md"
                    app:backgroundTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_scan"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:text="@string/new_scan"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/radius_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/share"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/primary"
                    app:cornerRadius="@dimen/radius_md" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
