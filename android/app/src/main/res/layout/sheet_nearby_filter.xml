<?xml version="1.0" encoding="utf-8"?>
<!-- "Scans near you" sort & filter overlay. Opened from the toolbar filter
     action; lets the user order the feed by date and narrow it to one
     disease type. The type chips are populated at runtime from the feed. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_3xl">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/nearby_filter_title"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium" />

        <!-- By date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/nearby_filter_by_date"
            android:textAllCaps="true"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="@dimen/space_sm">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_newest"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/nearby_filter_date_newest"
                app:checkedIconEnabled="false"
                app:chipBackgroundColor="@color/chip_bg_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_oldest"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_filter_date_oldest"
                app:checkedIconEnabled="false"
                app:chipBackgroundColor="@color/chip_bg_color" />

        </com.google.android.material.chip.ChipGroup>

        <!-- By type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/nearby_filter_by_type"
            android:textAllCaps="true"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/nearby_filter_apply" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
