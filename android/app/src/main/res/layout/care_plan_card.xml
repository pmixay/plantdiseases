<?xml version="1.0" encoding="utf-8"?>
<!--
    Body of CarePlanCardView (the card itself, its stroke and radius, stay in
    the view class).

    Two sections stack on one surface: the summary (header row, pills, key
    action, follow-up, buttons) and the details panel the user expands. Both
    use on_surface text on the card background. The status container holds
    the loading, error and filled states; the view shows one at a time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/care_plan_stack"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/care_plan_summary_padding_bottom">

        <!-- Accordion header: leaf icon + title + subtitle + chevron. -->
        <LinearLayout
            android:id="@+id/care_plan_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/care_plan_header_min_height"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/care_plan_header_icon_box"
                android:layout_height="@dimen/care_plan_header_icon_box">

                <ImageView
                    android:layout_width="@dimen/care_plan_header_icon"
                    android:layout_height="@dimen/care_plan_header_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_care"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/care_plan_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/care_plan_title"
                    android:textAppearance="@style/TextAppearance.App.CarePlan.Title" />

                <TextView
                    android:id="@+id/care_plan_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.App.CarePlan.Note"
                    tools:text="Tailored for Monstera" />
            </LinearLayout>

            <ImageView
                android:id="@+id/care_plan_chevron"
                android:layout_width="@dimen/care_plan_chevron"
                android:layout_height="@dimen/care_plan_chevron"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/primary" />
        </LinearLayout>

        <!-- Loading, error and the filled state swap inside this container. -->
        <LinearLayout
            android:id="@+id/care_plan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/care_plan_status_margin_top"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/care_plan_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="@dimen/care_plan_progress"
                    android:layout_height="@dimen/care_plan_progress"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/care_plan_loading"
                    android:textAppearance="@style/TextAppearance.App.CarePlan.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/care_plan_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/care_plan_error_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/care_plan_unavailable"
                    android:textAppearance="@style/TextAppearance.App.CarePlan.BodySm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/care_plan_retry"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/care_plan_retry_gap_top"
                    android:text="@string/care_plan_retry"
                    android:textColor="@color/on_surface"
                    app:cornerRadius="@dimen/care_plan_corner"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary" />
            </LinearLayout>

            <!-- Filled state: four pills in two rows. Icon and label are set
                 when the plan binds (they are plain data of the row). -->
            <LinearLayout
                android:id="@+id/care_plan_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/care_plan_pill_watering"
                        layout="@layout/care_plan_pill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/care_plan_pill_gap"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/care_plan_pill_fertilising"
                        layout="@layout/care_plan_pill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/care_plan_pill_gap"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/care_plan_pill_row_gap"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/care_plan_pill_light"
                        layout="@layout/care_plan_pill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/care_plan_pill_gap"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/care_plan_pill_humidity"
                        layout="@layout/care_plan_pill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/care_plan_pill_gap"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/care_plan_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_care_plan_pill"
                android:orientation="vertical"
                android:paddingStart="@dimen/care_plan_pill_padding_h"
                android:paddingTop="@dimen/care_plan_note_padding_top"
                android:paddingEnd="@dimen/care_plan_pill_padding_h"
                android:paddingBottom="@dimen/space_md"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/care_plan_disease_note"
                    android:textAppearance="@style/TextAppearance.App.CarePlan.Note" />

                <TextView
                    android:id="@+id/care_plan_note_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:lineSpacingExtra="@dimen/care_plan_line_extra"
                    android:textAppearance="@style/TextAppearance.App.CarePlan.Body"
                    tools:text="Remove the affected leaves." />
            </LinearLayout>

            <TextView
                android:id="@+id/care_plan_follow_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/care_plan_follow_up_gap_top"
                android:textAppearance="@style/TextAppearance.App.CarePlan.BodySm"
                android:visibility="gone"
                tools:text="Re-check in 14 days" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/care_plan_apply"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/care_plan_button_gap_top"
                android:text="@string/care_plan_use_for_reminders"
                android:textColor="@color/on_surface"
                android:visibility="gone"
                app:cornerRadius="@dimen/care_plan_corner"
                app:icon="@drawable/ic_clock"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary" />

            <!-- The toggle stays in the summary (it controls the panel below);
                 the panel itself sits on the card's base surface. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/care_plan_details_toggle"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/care_plan_toggle_margin_start"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/care_plan_show_details"
                android:textColor="@color/on_surface"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_down"
                app:iconGravity="textEnd"
                app:iconTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Details panel: shown only once the user opens it (see care_plan_details). -->
    <include
        android:id="@+id/care_plan_details"
        layout="@layout/care_plan_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
