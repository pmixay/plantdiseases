<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile screen.

    Refactor notes:
      • All cards now share App.GlassCard / App.GlassCard.Strong so
        radii, padding and translucency are uniform.
      • Spacing is on the @dimen/space_* grid — no more 4/6/10/14dp
        magic numbers.
      • The header gets a slim gradient hero so the page has a real
        starting point instead of dropping straight into a stat card.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Hero: leaf-green gradient block (bg_garden_hero), matching the
             Garden tab so the Profile no longer drops straight into a plain
             stat card. Gives the page a real starting point. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:orientation="vertical"
            android:background="@drawable/bg_garden_hero"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_2xl"
            android:paddingBottom="@dimen/space_xl">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_semi">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@null"
                    app:tint="@color/on_primary" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/tab_profile"
                android:textColor="@color/on_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/profile_subtitle"
                android:textColor="@color/on_primary_secondary"
                android:textSize="@dimen/text_body"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Server status (compact one-line glass pill row) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/server_status_card"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_md">

                <View
                    android:id="@+id/server_status_indicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/tv_server_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/server_checking"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/on_surface"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_diag_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/on_surface_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_diag_classes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/on_surface_secondary"
                    android:visibility="gone" />

                <!-- Plain ImageView, not a MaterialButton: the icon button's
                     min-width / insets were rendering the icon clipped and
                     flush to the card edge. fitCenter inside 40dp with 8dp
                     padding keeps the 24dp icon centered and clear. -->
                <ImageView
                    android:id="@+id/btn_refresh_health"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/diagnostics_refresh" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Shimmer stats placeholder -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_color="@color/shimmer_base"
            app:shimmer_highlight_color="@color/shimmer_highlight"
            app:shimmer_duration="1200">

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_glass_card" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Stats: a single glass card with a stat row + summary lines -->
        <!-- Stats: health-rate ring + animated count tiles -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stats_layout"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="116dp"
                        android:layout_height="116dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_health_ring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:progress="0"
                            app:indicatorSize="116dp"
                            app:trackThickness="10dp"
                            app:trackCornerRadius="6dp"
                            app:indicatorColor="@color/healthy_green"
                            app:trackColor="@color/divider" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_health_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="26sp"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium"
                                tools:text="100%" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/accuracy_rate"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:orientation="vertical">

                        <LinearLayout style="@style/Profile.StatTile">
                            <TextView android:id="@+id/tv_total_scans" style="@style/Profile.StatNum"
                                android:textColor="@color/primary" tools:text="42" />
                            <TextView style="@style/Profile.StatLabel" android:text="@string/total_scans" />
                        </LinearLayout>

                        <LinearLayout style="@style/Profile.StatTile" android:layout_marginTop="@dimen/space_sm">
                            <TextView android:id="@+id/tv_healthy_count" style="@style/Profile.StatNum"
                                android:textColor="@color/healthy_green" tools:text="40" />
                            <TextView style="@style/Profile.StatLabel" android:text="@string/healthy_plants" />
                        </LinearLayout>

                        <LinearLayout style="@style/Profile.StatTile" android:layout_marginTop="@dimen/space_sm">
                            <TextView android:id="@+id/tv_diseased_count" style="@style/Profile.StatNum"
                                android:textColor="@color/disease_red" tools:text="2" />
                            <TextView style="@style/Profile.StatLabel" android:text="@string/diseased_plants" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/most_common_disease"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tv_common_disease"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/none_yet"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4xl"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_scan"
                android:contentDescription="@string/no_scans_yet"
                app:tint="@color/primary_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/no_scans_yet"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/on_surface"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/start_scanning_hint"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface_secondary"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/first_scan_cta"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- Settings: language + theme -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- Flag-segmented language switch (replaces the plain button). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="3dp">

                    <LinearLayout
                        android:id="@+id/lang_en"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="18dp"
                            android:src="@drawable/flag_en"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tv_lang_en"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="English"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lang_ru"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="18dp"
                            android:src="@drawable/flag_ru"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tv_lang_ru"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="Русский"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_setting"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:layout_marginBottom="@dimen/space_sm" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="@dimen/space_sm">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_light"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_light"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_dark"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_system"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_system"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Tools: light meter + how-to-use -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Light Meter card used to live here. It moved into
                     per-plant context on the plant-detail screen
                     (where the meter pre-selects the right species
                     bucket and persists the session peak back onto
                     the plant) and was deleted from this surface as
                     part of the production-polish pass. -->

                <!-- Inline "how to use" mini-guide: replaces the old
                     full-screen onboarding re-open button with a quick
                     three-step strip so the user can refresh memory
                     without leaving the profile screen. Each column is
                     a tappable shortcut into the relevant tab. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/how_to_use_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <LinearLayout
                            android:id="@+id/step_scan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/space_xs"
                            android:clickable="false"
                            android:focusable="false">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_scan"
                                    app:tint="@color/primary" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:text="@string/tab_scan"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/how_to_use_step_scan"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="1dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_diagnose"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/space_xs"
                            android:clickable="false"
                            android:focusable="false">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_disease"
                                    app:tint="@color/primary" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:text="@string/onboarding_diagnose_title"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/how_to_use_step_diagnose"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="1dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_care"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/space_xs"
                            android:clickable="false"
                            android:focusable="false">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_care"
                                    app:tint="@color/primary" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:text="@string/onboarding_care_title"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/how_to_use_step_care"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="1dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Community contributions: toggle + clear-my-contributions
             button. The toggle reflects CommunityPrefs.uploadsEnabled
             and the delete button hits /api/community/user/{id}. -->
        <!-- Community: gradient social card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:contentPadding="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_community_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_circle_on_primary">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_community"
                            app:tint="@color/on_primary"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/space_md"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/community_toggle_title"
                            android:textSize="@dimen/text_title_sm"
                            android:textColor="@color/on_primary"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/community_toggle_subtitle"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/on_primary_secondary"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_community"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/on_primary"
                        app:trackTint="#44FFFFFF"
                        app:trackDecorationTint="#66FFFFFF" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_community"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/community_delete_title"
                    android:textColor="@color/on_primary"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/on_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- My second opinions — what this install has contributed.
             Collapsible: tap the header row to fold/unfold the list. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_my_opinions"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header row — tappable to fold/unfold the content below. -->
                <LinearLayout
                    android:id="@+id/header_my_opinions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/community_my_opinions_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <ImageView
                        android:id="@+id/iv_my_opinions_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="@color/on_surface_secondary"
                        android:contentDescription="@string/community_my_opinions_title" />

                </LinearLayout>

                <!-- Collapsible content. -->
                <LinearLayout
                    android:id="@+id/ll_my_opinions_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Headline stat: how many diagnoses this install has
                         weighed in on. Hidden until there's at least one. -->
                    <LinearLayout
                        android:id="@+id/ll_my_opinions_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_my_opinions_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="34sp"
                            android:textColor="@color/primary"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="-0.02"
                            tools:text="7" />

                        <TextView
                            android:id="@+id/tv_my_opinions_count_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_marginBottom="6dp"
                            android:text="@string/community_my_opinions_count_label"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/on_surface_secondary"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                    <!-- "What you flag most" — a small horizontal bar chart
                         of the user's opinion distribution, built in code. -->
                    <TextView
                        android:id="@+id/tv_my_opinions_breakdown_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/community_my_opinions_breakdown"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/on_surface_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/ll_my_opinions_chart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Recent opinions list (styled rows, built in code). -->
                    <TextView
                        android:id="@+id/tv_my_opinions_recent_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/community_my_opinions_recent"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/on_surface_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/ll_my_opinions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/space_xs" />

                    <TextView
                        android:id="@+id/tv_my_opinions_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/community_my_opinions_empty"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Footer: version. The "clear all history" action moved to the
             Gallery tab's top-app-bar basket, next to the scans it wipes. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/on_surface_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
