<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile screen — minimal, sharing the Garden tab's visual language.

      • Header is a plain page header like Home and Community: title row,
        then the circular provider avatar (or a placeholder) beside the
        account status line.
      • Every section is the same App.GlassCard so radii, padding and
        translucency are uniform; sections are separated only by the
        @dimen/space_* grid (no 4/6/10/14dp magic numbers).
      • Section titles all use TextAppearance.App.Title.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/content_gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg">

        <!-- Page header, like the Home and Community tabs: the nickname (or
             "Profile") as the title with the edit action beside it, then the
             avatar next to the account status line. The toolbar is hidden on
             this tab (see MainActivity); ProfileFragment pads the scroll view
             by the status-bar inset. -->
        <LinearLayout
            android:id="@+id/profile_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- A long nickname shrinks (ellipsizes) instead of pushing the
                 edit button off. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_profile_hero_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:text="@string/tab_profile"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_title" />

                <ImageButton
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/account_edit_profile"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_note_pencil"
                    android:visibility="gone"
                    app:tint="@color/on_surface" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/profile_avatar_picker"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:clickable="true"
                    android:contentDescription="@string/account_change_avatar"
                    android:enabled="false"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_profile_avatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@color/icon_bg"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_placeholder"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Avatar"
                        app:tint="@color/primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_profile_hero_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/profile_subtitle"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- Signed out, restoring or unfinished account: the way in. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:minHeight="56dp"
                android:text="@string/account_sign_in_or_create"
                android:visibility="gone"
                app:icon="@drawable/ic_profile"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pro_card"
            style="@style/App.GlassCard.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/pro_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/pro_profile_body"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/pro_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings: language + theme -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_card"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:accessibilityHeading="true"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- Flag-segmented language switch (replaces the plain button). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="3dp">

                    <LinearLayout
                        android:id="@+id/lang_en"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_flag_us"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_lang_en"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="English"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lang_ru"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_flag_ru"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_lang_ru"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="Русский"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_setting"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:accessibilityHeading="true"
                    android:layout_marginBottom="@dimen/space_sm" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="@dimen/space_sm">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_light"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_light"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_dark"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_system"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_system"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                </com.google.android.material.chip.ChipGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <!-- Autosave snapped scan photos to the device gallery. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/autosave_title"
                            android:textAppearance="@style/TextAppearance.App.Title"
                            android:accessibilityHeading="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/autosave_subtitle"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/on_surface"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_autosave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:contentDescription="@string/autosave_title" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/telemetry_consent_title"
                            android:textAppearance="@style/TextAppearance.App.Title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/telemetry_consent_subtitle"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/text_body_sm" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_telemetry_consent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:contentDescription="@string/telemetry_consent_title" />
                </LinearLayout>

                <!-- Show the local profile photo in Community (opt-in); only for a
                     signed-in member. Wired to CommunityAvatarSync. -->
                <LinearLayout
                    android:id="@+id/community_photo_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_md"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/community_photo_setting_title"
                                android:textAppearance="@style/TextAppearance.App.Title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/community_photo_setting_subtitle"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_body_sm" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_community_photo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:contentDescription="@string/community_photo_setting_title" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <include
            android:id="@+id/row_my_scans"
            layout="@layout/item_profile_link_row" />

        <include
            android:id="@+id/row_achievements"
            layout="@layout/item_profile_link_row" />

        <include
            android:id="@+id/row_moderation"
            layout="@layout/item_profile_link_row"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/replay_guidance_row"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="64dp"
            android:contentDescription="@string/replay_guidance_title">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_rotate"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/replay_guidance_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/replay_guidance_subtitle"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/privacy_policy_row"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clickable="true"
            android:contentDescription="@string/privacy_policy_title"
            android:focusable="true"
            android:minHeight="64dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_policy_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/privacy_policy_subtitle"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Stats and settings below. -->

        <!-- Shimmer stats placeholder -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_color="@color/shimmer_base"
            app:shimmer_highlight_color="@color/shimmer_highlight"
            app:shimmer_duration="1200">

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_glass_card" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Stats: ONE glass card — health-rate ring + animated count tiles,
             most-common disease, the 7-day activity chart and top issues.
             (Previously split across two cards; unified per design pass.) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stats_layout"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    android:text="@string/stats_section"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:accessibilityHeading="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="116dp"
                        android:layout_height="116dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_health_ring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:progress="0"
                            app:indicatorSize="116dp"
                            app:trackThickness="10dp"
                            app:trackCornerRadius="6dp"
                            app:indicatorColor="@color/healthy_green"
                            app:trackColor="@color/divider" />

                        <LinearLayout
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_health_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="24sp"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium"
                                tools:text="100%" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/accuracy_rate"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface"
                                android:gravity="center"
                                android:lineSpacingMultiplier="0.95" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:orientation="vertical">

                        <LinearLayout style="@style/Profile.StatTile">
                            <TextView android:id="@+id/tv_total_scans" style="@style/Profile.StatNum"
                                android:textColor="@color/primary" tools:text="42" />
                            <TextView style="@style/Profile.StatLabel" android:text="@string/total_scans" />
                        </LinearLayout>

                        <LinearLayout style="@style/Profile.StatTile" android:layout_marginTop="@dimen/space_sm">
                            <TextView android:id="@+id/tv_healthy_count" style="@style/Profile.StatNum"
                                android:textColor="@color/healthy_green" tools:text="40" />
                            <TextView style="@style/Profile.StatLabel" android:text="@string/healthy_plants" />
                        </LinearLayout>

                        <LinearLayout style="@style/Profile.StatTile" android:layout_marginTop="@dimen/space_sm">
                            <TextView android:id="@+id/tv_diseased_count" style="@style/Profile.StatNum"
                                android:textColor="@color/disease_red" tools:text="2" />
                            <TextView style="@style/Profile.StatLabel" android:text="@string/diseased_plants" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_md"
                        android:text="@string/most_common_disease"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tv_common_disease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="@string/none_yet"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface"
                        android:textAlignment="viewEnd"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <!-- 7-day bar chart -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_last_7_days"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <com.plantdiseases.app.ui.widget.BarChartView
                    android:id="@+id/bar_week"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/space_sm" />

                <!-- Top issues -->
                <TextView
                    android:id="@+id/tv_top_issues_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/stats_top_issues"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list_top_issues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The "Guides & tips" cards that used to follow here moved into the
             Guide handbook (Home → Guide → App help). -->

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4xl"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_scan"
                android:contentDescription="@string/no_scans_yet"
                app:tint="@color/primary_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/no_scans_yet"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/on_surface"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/start_scanning_hint"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/first_scan_cta"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- Community contributions: delete-my-data. Enabling/disabling
             community now lives inside the community screen itself. -->
        <!-- Footer: version. The "clear all history" action moved to the
             Gallery tab's top-app-bar basket, next to the scans it wipes.
             The version row doubles as the HIDDEN admin entry: 7 quick taps
             open the data-labeling password gate (dev-options pattern; the
             visible button was removed for the Play release). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:padding="@dimen/space_sm"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/on_surface" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
