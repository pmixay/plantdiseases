<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile screen.

    Refactor notes:
      • All cards now share App.GlassCard / App.GlassCard.Strong so
        radii, padding and translucency are uniform.
      • Spacing is on the @dimen/space_* grid — no more 4/6/10/14dp
        magic numbers.
      • The header gets a slim gradient hero so the page has a real
        starting point instead of dropping straight into a stat card.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Server status (compact one-line glass pill row) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/server_status_card"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_md">

                <View
                    android:id="@+id/server_status_indicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/tv_server_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/server_checking"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/on_surface"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_diag_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/on_surface_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_diag_classes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/on_surface_secondary"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh_health"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/diagnostics_refresh"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Shimmer stats placeholder -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_color="@color/shimmer_base"
            app:shimmer_highlight_color="@color/shimmer_highlight"
            app:shimmer_duration="1200">

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_glass_card" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Stats: a single glass card with a stat row + summary lines -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stats_layout"
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_total_scans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textColor="@color/primary"
                            android:fontFamily="sans-serif-medium"
                            tools:text="42" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/total_scans"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/on_surface_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_healthy_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textColor="@color/healthy_green"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/healthy_plants"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/on_surface_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_diseased_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textColor="@color/disease_red"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/diseased_plants"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/on_surface_secondary" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/accuracy_rate"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tv_health_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/most_common_disease"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tv_common_disease"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/none_yet"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4xl"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_scan"
                android:contentDescription="@string/no_scans_yet"
                app:tint="@color/primary_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/no_scans_yet"
                android:textSize="@dimen/text_title_sm"
                android:textColor="@color/on_surface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/start_scanning_hint"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface_secondary"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/first_scan_cta"
                app:icon="@drawable/ic_scan"
                app:cornerRadius="@dimen/radius_md"
                app:backgroundTint="@color/primary" />

        </LinearLayout>

        <!-- Settings: language + theme -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_language"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change_language"
                        app:cornerRadius="@dimen/radius_md" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_setting"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:layout_marginBottom="@dimen/space_sm" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="@dimen/space_sm">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_light"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_light"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_dark"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_theme_system"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_system"
                        app:chipBackgroundColor="@color/chip_bg_color"
                        app:checkedIconEnabled="false" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Tools: light meter + how-to-use -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/card_light_meter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_light"
                        android:contentDescription="@string/light_meter"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/light_meter"
                        android:textSize="@dimen/text_title_sm"
                        android:textColor="@color/on_surface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        app:tint="@color/on_surface_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/space_lg"
                    android:background="@color/divider" />

                <!-- Inline "how to use" mini-guide: replaces the old
                     full-screen onboarding re-open button with a quick
                     three-step strip so the user can refresh memory
                     without leaving the profile screen. Each column is
                     a tappable shortcut into the relevant tab. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/how_to_use_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <LinearLayout
                            android:id="@+id/step_scan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/space_xs"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_scan"
                                    app:tint="@color/primary" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:text="@string/tab_scan"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/how_to_use_step_scan"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="1dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_diagnose"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/space_xs"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_disease"
                                    app:tint="@color/primary" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:text="@string/onboarding_diagnose_title"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/how_to_use_step_diagnose"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="1dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/step_care"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/space_xs"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_care"
                                    app:tint="@color/primary" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:text="@string/onboarding_care_title"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/how_to_use_step_care"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="1dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Footer: clear history + version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_history"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_history"
                android:textColor="@color/disease_red"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/disease_red" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/on_surface_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
