<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom sheet shown when the user taps "Wrong" on a diagnosis. The
    layout is intentionally heavier-than-a-dialog so the structured
    payload (class chips + reason chips + free-text note with a live
    char counter) lands cleanly in one screen without forcing the
    keyboard up unprompted.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_2xl">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/tv_sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sheet_title"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/feedback_sheet_subtitle"
            android:textSize="@dimen/text_body_sm"
            android:textColor="@color/on_surface_secondary" />

        <!-- Currently-predicted diagnosis pill (set programmatically). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_predicted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_disease"
                    app:tint="@color/on_surface_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/feedback_sheet_we_thought"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/tv_predicted_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/on_surface"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Fungal Leaf Spot" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- "What is it actually?" — class picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/feedback_sheet_actual_label"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:singleSelection="true"
            app:selectionRequired="false"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:chipSpacingVertical="@dimen/space_xs" />

        <!-- "Why?" — reason picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/feedback_sheet_reason_label"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:singleSelection="true"
            app:selectionRequired="false"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:chipSpacingVertical="@dimen/space_xs" />

        <!-- Free-text note + char counter -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_note"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/feedback_sheet_note_hint"
            app:boxCornerRadiusTopStart="@dimen/radius_md"
            app:boxCornerRadiusTopEnd="@dimen/radius_md"
            app:boxCornerRadiusBottomStart="@dimen/radius_md"
            app:boxCornerRadiusBottomEnd="@dimen/radius_md"
            app:counterEnabled="true"
            app:counterMaxLength="2000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2000"
                android:minLines="3"
                android:maxLines="6" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_send"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
