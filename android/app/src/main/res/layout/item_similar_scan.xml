<?xml version="1.0" encoding="utf-8"?>
<!--
    Single cell in the "Similar scans near you" carousel.

    Each cell is a 160dp-wide card: thumbnail on top, then the diagnosis,
    the approximate distance ("≈ N km") and relative time below. No author
    and no place name (geo stays server-side). Tapping expands the photo.
    Width is fixed so the horizontal RecyclerView snaps evenly regardless of
    label length.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_similar_thumb"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            app:shimmer_auto_start="false"
            app:shimmer_base_color="@color/shimmer_base"
            app:shimmer_duration="1000"
            app:shimmer_highlight_color="@color/shimmer_highlight">

            <ImageView
                android:id="@+id/iv_similar_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="?attr/colorSurfaceVariant"
                android:contentDescription="@null" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm">

            <TextView
                android:id="@+id/tv_similar_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_similar_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_similar_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/on_surface" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
