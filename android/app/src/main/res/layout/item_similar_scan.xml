<?xml version="1.0" encoding="utf-8"?>
<!--
    Single cell in the "Similar scans near you" horizontal carousel.
    Sized so 3-4 cells peek into the screen at typical phone widths.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="96dp"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_variant">

        <ImageView
            android:id="@+id/iv_similar_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            app:tint="@null" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_similar_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/on_surface_secondary"
        android:lineSpacingExtra="1dp" />

</LinearLayout>
