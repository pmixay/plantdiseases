<?xml version="1.0" encoding="utf-8"?>
<!-- Health card on the plant-detail Overview tab: status-tinted heart, title,
     score, week-delta pill and dated sparkline. Without a score only the title
     and the "scan again" empty line show; the controller toggles the rest. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/detail_card_elevation"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/detail_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/detail_card_pad_h"
        android:paddingVertical="@dimen/detail_card_pad_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/detail_health_icon"
                android:layout_width="@dimen/detail_health_icon"
                android:layout_height="@dimen/detail_health_icon"
                android:layout_marginEnd="@dimen/detail_health_icon_gap"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="@dimen/detail_health_icon_pad"
                android:src="@drawable/ic_heart" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/plant_health_title"
                android:textAppearance="@style/TextAppearance.Detail.HeaderTitle" />

            <TextView
                android:id="@+id/detail_health_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Detail.Score"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_health_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/detail_health_empty_gap"
            android:lineSpacingExtra="@dimen/detail_line_spacing"
            android:textAppearance="@style/TextAppearance.Detail.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail_health_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/detail_health_delta_gap"
            android:background="@drawable/bg_stat_pill"
            android:paddingHorizontal="@dimen/detail_pill_pad_h"
            android:paddingVertical="@dimen/detail_pill_pad_v"
            android:textAppearance="@style/TextAppearance.Detail.Caption"
            android:visibility="gone" />

        <com.plantdiseases.app.ui.garden.SparklineView
            android:id="@+id/detail_health_sparkline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/detail_sparkline_height"
            android:layout_marginTop="@dimen/detail_sparkline_gap"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
