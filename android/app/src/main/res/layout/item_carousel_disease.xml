<?xml version="1.0" encoding="utf-8"?>
<!-- One cell shared by the Home "Popular diseases" and "Disease guide"
     carousels: a tinted icon header (the per-disease ic_disease_* drawable),
     the localized name and a subtitle (scan count for popular, "Guide" for
     the documentation row). Fixed 150dp width so the row snaps evenly. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/icon_wrap"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@color/disease_red_bg">

            <!-- Server example photo (GuideDataProvider.exampleImageUrl). Stays
                 VISIBLE (an empty ImageView is transparent) so Glide can measure
                 it and actually start the load — a GONE target never resolves a
                 size, so the request would never fire. The vector below is drawn
                 on top as the placeholder until the photo arrives. -->
            <ImageView
                android:id="@+id/iv_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Fallback / backdrop: the tinted disease vector, shown until the
                 photo resolves, or for offline / no-photo / load-failure. -->
            <ImageView
                android:id="@+id/iv_disease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:tint="@color/disease_red"
                android:contentDescription="@null" />

            <!-- Spinner while the photo loads. -->
            <ProgressBar
                android:id="@+id/photo_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/disease_red"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm">

            <TextView
                android:id="@+id/tv_disease_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:minLines="2"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/tv_disease_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
