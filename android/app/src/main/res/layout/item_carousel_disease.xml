<?xml version="1.0" encoding="utf-8"?>
<!-- One cell shared by the Home "Popular diseases" and "Disease guide"
     carousels: a tinted icon header (the per-disease ic_disease_* drawable),
     the localized name and a subtitle (scan count for popular, "Guide" for
     the documentation row). Fixed 150dp width so the row snaps evenly. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/icon_wrap"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@color/disease_red_bg">

            <ImageView
                android:id="@+id/iv_disease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:tint="@color/disease_red"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm">

            <TextView
                android:id="@+id/tv_disease_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/tv_disease_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
