<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom crop screen.

    Seamless: the whole screen (and the band behind the system bars) is
    @color/background, so there is no distinct top navbar — the top area and
    the crop canvas are one continuous block. The photo is stretched
    adaptively to fill the viewport (letterbox-fit) by the CropImageView.
    All controls live in a fixed floating rounded green-glass panel at the
    bottom — nothing sits on top.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/crop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Crop canvas — fills the screen. Side/top padding floats the image
         off the edges (and keeps edge handles grabbable); the bottom
         padding reserves room so the crop rect never hides behind the
         floating panel. -->
    <com.plantdiseases.app.ui.crop.CropImageView
        android:id="@+id/crop_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="104dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating control panel — fixed position (not draggable). -->
    <LinearLayout
        android:id="@+id/crop_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_crop_panel"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:contentDescription="@string/crop_action_cancel"
            app:icon="@drawable/ic_close"
            app:iconSize="24dp"
            app:iconTint="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rotate"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/space_lg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:contentDescription="@string/crop_action_rotate"
            app:icon="@drawable/ic_rotate"
            app:iconSize="24dp"
            app:iconTint="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/space_lg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:contentDescription="@string/crop_action_done"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_check"
            app:iconSize="24dp"
            app:iconTint="@color/on_primary"
            tools:ignore="ContentDescription" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
