<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen species detail, opened from the Home "Trending species"
    carousel (and reusable elsewhere). A large Wikipedia lead photo under a
    gradient toolbar, the common/scientific name, the encyclopedia blurb, a
    care-at-a-glance block (filled from /api/care-plan), pet toxicity,
    flowering, native range, common problems, other community scans of this
    species, and the Wikipedia link. This is the one screen that owns species
    information; every other surface links here via SpeciesInfoCardView.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/species_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:titleTextColor="@color/toolbar_title" />

        <!-- No offline strip: the blurb, photos and care plan are cached per
             species and the common-problems list falls back to the bundled
             guide, so this screen still has something real to show. What it
             owes the user is a note that the content is saved rather than
             live — see tv_offline_saved_note below, which sits with the text
             it describes. -->
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/species_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_3xl">

            <ImageView
                android:id="@+id/iv_species_hero"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#11000000"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_plant_placeholder"
                android:contentDescription="@null" />

            <!-- Extra reference photos (Wikipedia media-list), built
                 programmatically by SpeciesDetailActivity. -->
            <HorizontalScrollView
                android:id="@+id/photo_strip_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/content_gutter"
                android:paddingTop="@dimen/space_md"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/photo_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/content_gutter"
                android:paddingTop="@dimen/space_lg">

                <LinearLayout
                    android:id="@+id/species_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_species_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_headline" />

                <TextView
                    android:id="@+id/tv_species_scientific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="italic" />

                <!-- Shown only while offline AND showing cached species
                     content, so the user can tell live data from saved. -->
                <TextView
                    android:id="@+id/tv_offline_saved_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/offline_saved_data_note"
                    android:textColor="@color/warning_amber"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone" />

                <!-- A full Wikipedia lead section can run many paragraphs, so
                     it starts clipped; the toggle below is revealed by the
                     Activity only when the text is actually cut off. -->
                <TextView
                    android:id="@+id/tv_species_extract"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="@integer/species_extract_collapsed_lines"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:id="@+id/extract_expand_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/species_info_touch_target"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_extract_expand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/species_info_expand"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_body" />

                    <ImageView
                        android:id="@+id/iv_extract_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wikipedia"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/identify_wikipedia"
                    android:visibility="gone"
                    app:icon="@drawable/ic_world_map"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_sm"
                    app:iconSize="18dp"
                    app:iconTint="?attr/colorPrimary" />

                </LinearLayout>

                <!-- Care at a glance — the same rich CarePlanCardView the scan
                     result and garden detail render, inserted here at runtime
                     (gradient header + watering/light/humidity pills +
                     expandable details). -->
                <FrameLayout
                    android:id="@+id/care_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />

                <!-- Pet-toxicity card — same surface the scan result uses
                     (icon + title + body, red for toxic / green for pet-safe),
                     populated from the care plan's toxicity fields. Replaces
                     the old barely-visible "Toxic to pets" text line. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_toxicity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_lg">

                        <ImageView
                            android:id="@+id/iv_toxicity_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_warning"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_toxicity_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_toxicity_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Flowering calendar and its bloom trigger are sourced from
                     the same optional /api/species-profile response as the
                     map below. Each card exposes its own loading state, then
                     independently shows content or disappears when absent. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_flowering"
                    style="@style/App.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface"
                    app:contentPadding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <LinearLayout
                            android:id="@+id/flowering_header"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/species_info_touch_target"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_garden"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/flowering_title"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_title_sm" />

                            <ImageView
                                android:id="@+id/iv_flowering_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="@dimen/space_sm"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="@color/primary" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/flowering_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/flowering_loading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:indeterminate="true"
                                    android:importantForAccessibility="no"
                                    app:indicatorColor="@color/primary"
                                    app:indicatorSize="22dp"
                                    app:trackThickness="2dp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:text="@string/flowering_loading"
                                    android:textColor="@color/on_surface_secondary"
                                    android:textSize="@dimen/text_body_sm" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/flowering_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.plantdiseases.app.ui.widget.FloweringChartView
                                    android:id="@+id/flowering_chart"
                                    android:layout_width="match_parent"
                                    android:layout_height="184dp"
                                    android:layout_marginTop="@dimen/space_sm" />

                                <TextView
                                    android:id="@+id/tv_flowering_indoor_note"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_sm"
                                    android:lineSpacingExtra="2dp"
                                    android:textColor="@color/on_surface_secondary"
                                    android:textSize="@dimen/text_body_sm"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/card_flowering_conditions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_lg"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:visibility="gone">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:contentDescription="@null"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_light"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_md"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-medium"
                                            android:text="@string/flowering_conditions_title"
                                            android:textColor="@color/on_surface"
                                            android:textSize="@dimen/text_body" />

                                        <TextView
                                            android:id="@+id/tv_flowering_conditions"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/space_xs"
                                            android:lineSpacingExtra="2dp"
                                            android:textColor="@color/on_surface_secondary"
                                            android:textSize="@dimen/text_body_sm" />

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Optional /api/species-profile native-range section. The
                     custom view owns its offline Canvas geometry, tap state
                     and selected-country result; this card only supplies the
                     surrounding species-screen title and server summary. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_native_range"
                    style="@style/App.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/native_range_header"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/species_info_touch_target"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/native_range_title"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/text_title_sm" />

                            <ImageView
                                android:id="@+id/iv_native_range_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="@dimen/space_sm"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="@color/primary" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/native_range_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/native_range_loading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:indeterminate="true"
                                    android:importantForAccessibility="no"
                                    app:indicatorColor="@color/primary"
                                    app:indicatorSize="22dp"
                                    app:trackThickness="2dp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:text="@string/native_range_loading"
                                    android:textColor="@color/on_surface_secondary"
                                    android:textSize="@dimen/text_body_sm" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/native_range_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tv_native_range_summary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:lineSpacingExtra="2dp"
                                    android:textColor="@color/on_surface_secondary"
                                    android:textSize="@dimen/text_body_sm" />

                                <com.plantdiseases.app.ui.widget.WorldMapView
                                    android:id="@+id/world_map"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_md" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Common problems for this species (AI list with guide
                     links, or the bundled disease guide as fallback). Rows
                     built programmatically by SpeciesDetailActivity. -->
                <TextView
                    android:id="@+id/tv_diseases_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/species_common_problems"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />


                <ProgressBar
                    android:id="@+id/pb_diseases"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list_diseases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- The fallback path renders the whole bundled catalogue (17
                     cards). The Activity keeps the first few visible and hides
                     the rest behind this toggle so the screen doesn't end in a
                     wall of guide links. -->
                <LinearLayout
                    android:id="@+id/diseases_expand_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/species_info_touch_target"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_diseases_expand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_body"
                        tools:text="Show all 17" />

                    <ImageView
                        android:id="@+id/iv_diseases_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Other community scans of this species. Moved here from the
                     scan result screen so every species surface lives on one
                     page; hidden when the community has nothing for it. -->
                <TextView
                    android:id="@+id/tv_species_community_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/species_community_others"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_species_community"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
