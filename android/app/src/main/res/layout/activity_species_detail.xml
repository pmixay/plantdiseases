<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen species detail, opened from the Home "Trending species"
    carousel (and reusable elsewhere). A large Wikipedia lead photo under a
    gradient toolbar, the common/scientific name, the encyclopedia blurb, a
    care-at-a-glance block (filled from /api/care-plan), and add-to-garden /
    scan-health / Wikipedia actions.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/species_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:titleTextColor="@color/toolbar_title" />

        <!-- Shared offline notice, pinned under the toolbar. The blurb, photos
             and care plan are cached per species; the common-problems list
             falls back to the bundled guide. -->
        <com.plantdiseases.app.ui.common.OfflineNoticeView
            android:id="@+id/offline_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/species_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_3xl">

            <ImageView
                android:id="@+id/iv_species_hero"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#11000000"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_plant_placeholder"
                android:contentDescription="@null" />

            <!-- Extra reference photos (Wikipedia media-list), built
                 programmatically by SpeciesDetailActivity. -->
            <HorizontalScrollView
                android:id="@+id/photo_strip_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/content_gutter"
                android:paddingTop="@dimen/space_md"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/photo_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/content_gutter"
                android:paddingTop="@dimen/space_lg">

                <TextView
                    android:id="@+id/tv_species_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_headline" />

                <TextView
                    android:id="@+id/tv_species_scientific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="italic" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_species_extract"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wikipedia"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/identify_wikipedia"
                    android:visibility="gone" />

                <!-- Care at a glance — the same rich CarePlanCardView the scan
                     result and garden detail render, inserted here at runtime
                     (gradient header + watering/light/humidity pills +
                     expandable details). -->
                <FrameLayout
                    android:id="@+id/care_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />

                <!-- Pet-toxicity card — same surface the scan result uses
                     (icon + title + body, red for toxic / green for pet-safe),
                     populated from the care plan's toxicity fields. Replaces
                     the old barely-visible "Toxic to pets" text line. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_toxicity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_lg">

                        <ImageView
                            android:id="@+id/iv_toxicity_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_warning"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_toxicity_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_toxicity_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textSize="@dimen/text_body_sm"
                                android:textColor="@color/on_surface_secondary"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Common problems for this species (AI list with guide
                     links, or the bundled disease guide as fallback). Rows
                     built programmatically by SpeciesDetailActivity. -->
                <TextView
                    android:id="@+id/tv_diseases_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/species_common_problems"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_diseases_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/pb_diseases"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list_diseases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- baselineAligned=false + match_parent heights keep both
                     buttons the same height even when one label wraps to two
                     lines at a large font scale (they'd otherwise sit at
                     different levels). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_garden"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/identify_add_garden" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scan_health"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/identify_scan_health" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
