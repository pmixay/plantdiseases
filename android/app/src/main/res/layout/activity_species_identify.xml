<?xml version="1.0" encoding="utf-8"?>
<!--
    "Identify my plant" — now a full live-camera screen mirroring the disease
    scanner (it hosts CameraFragment in identify mode). A close button overlays
    the top-left; after a capture the candidate panel slides up over the camera
    controls, and a scrim+spinner covers the screen while PlantNet runs. The
    actual capture UI (preview, shutter, gallery, flash, grid, focus) is the
    shared CameraFragment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/identify_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Close (back to Home). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/space_md"
        android:contentDescription="@string/close"
        android:elevation="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_close"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:cornerRadius="24dp" />

    <!-- Candidate picker — appears over the camera controls after a capture. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/candidates_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/space_md"
        android:elevation="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:id="@+id/candidates_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/identify_pick_candidate"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title_sm" />

            <TextView
                android:id="@+id/candidates_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body_sm"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/candidates_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retake"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/identify_retake" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Identifying scrim + spinner. -->
    <FrameLayout
        android:id="@+id/identify_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white" />
    </FrameLayout>
</FrameLayout>
