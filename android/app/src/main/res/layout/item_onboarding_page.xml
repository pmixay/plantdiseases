<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped in a ScrollView (fillViewport keeps the column centered when it
     fits) so the page never clips in landscape, on short screens, or at large
     system font sizes — it just scrolls instead. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/space_4xl">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_animation"
        android:layout_width="240dp"
        android:layout_height="240dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3xl"
        android:gravity="center"
        android:textSize="@dimen/text_headline"
        android:textColor="@color/on_surface"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:textSize="@dimen/text_title_sm"
        android:textColor="@color/on_surface_secondary"
        android:lineSpacingExtra="4dp" />

    <!-- Optional tappable link (the consent page's privacy policy) -->
    <TextView
        android:id="@+id/tv_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:padding="@dimen/space_sm"
        android:gravity="center"
        android:textSize="@dimen/text_title_sm"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:visibility="gone" />

    </LinearLayout>
</ScrollView>
