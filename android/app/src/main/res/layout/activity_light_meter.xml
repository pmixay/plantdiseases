<?xml version="1.0" encoding="utf-8"?>
<!--
    Light meter. Gradient toolbar over a scrollable column: the live lux
    gauge (number + status + adaptive log progress bar + scale ticks),
    the plant-type chip row with its ideal-range card, and a tip card.
    The scale ticks, the species chips and the no-sensor camera fallback
    are filled in by LightMeterActivity; everything else is declared here.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/light_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/light_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/light_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:title="@string/light_meter"
            app:titleTextColor="@color/toolbar_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/light_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/light_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_3xl">

            <!-- Gauge card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="@dimen/glass_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_2xl"
                    android:paddingTop="@dimen/space_3xl"
                    android:paddingBottom="@dimen/space_2xl">

                    <TextView
                        android:id="@+id/light_lux"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_measuring"
                        android:textColor="@color/primary"
                        android:textSize="64sp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        tools:text="1,240" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-4dp"
                        android:text="@string/light_lux"
                        android:textColor="@color/on_surface_secondary"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/light_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textSize="@dimen/text_title_sm"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Good light"
                        tools:textColor="@color/primary" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/light_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/card_stroke"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp" />

                    <!-- Scale ticks are positioned algorithmically in code. -->
                    <FrameLayout
                        android:id="@+id/light_scale_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Light needs — auto-detected from the plant's species; the
                 ideal-range card below names the detected type. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/light_needs_header"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="@dimen/glass_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:id="@+id/light_species_ideal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Ideal for Tropical: 500 – 3000 lux" />

                    <TextView
                        android:id="@+id/light_species_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/on_surface_secondary"
                        android:textSize="@dimen/text_body_sm"
                        tools:text="Good light" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tip card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/light_tip_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="@dimen/glass_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_light"
                        android:contentDescription="@null"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/light_tip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/light_tip_ideal"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_body"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
