<?xml version="1.0" encoding="utf-8"?>
<!-- One reference row of the care-plan "Setup" section: a label over its value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/care_plan_row_gap"
    android:orientation="vertical">

    <TextView
        android:id="@+id/care_plan_setup_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:textAppearance="@style/TextAppearance.App.CarePlan.Note"
        tools:text="Placement" />

    <TextView
        android:id="@+id/care_plan_setup_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:lineSpacingExtra="@dimen/care_plan_line_extra"
        android:textAppearance="@style/TextAppearance.App.CarePlan.Item"
        tools:text="Bright room, away from drafts" />
</LinearLayout>
