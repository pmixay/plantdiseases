<?xml version="1.0" encoding="utf-8"?>
<!--
    One "common problem" row on the species detail screen. Tappable when the
    item maps to a bundled disease guide doc (chevron shown); plain card
    otherwise. Populated by SpeciesDetailActivity.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/disease_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="@dimen/space_md"
            android:contentDescription="@null"
            android:src="@drawable/ic_disease"
            app:tint="@color/disease_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/disease_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/disease_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body_sm"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/disease_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/on_surface_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
