<?xml version="1.0" encoding="utf-8"?>
<!-- The disclosure stays scrollable for small displays and large font sizes.
     Both optional data uses default off; Continue is always available. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_2xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            android:id="@+id/consent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/consent_title"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:id="@+id/consent_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:lineSpacingExtra="4dp"
            android:text="@string/consent_body"
            android:textColor="@color/on_surface_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/consent_privacy_link"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_md"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_md"
            android:text="@string/consent_privacy_link"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_title_sm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/training_consent_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/training_consent_subtitle"
            android:textColor="@color/on_surface_secondary"
            android:textSize="@dimen/text_body_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/consent_agree"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/consent_agree"
            android:textSize="@dimen/text_title_sm"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_md" />

    </LinearLayout>

</ScrollView>
