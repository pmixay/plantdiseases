<?xml version="1.0" encoding="utf-8"?>
<!-- The plant-care guide (GuideActivity): a plain header with a back arrow
     over GuideFragment's category tabs, search and article list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/guide_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/guide_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationContentDescription="@string/forum_back"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/toolbar_title"
            app:title="@string/tab_guide"
            app:titleTextColor="@color/toolbar_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/guide_container"
        android:name="com.plantdiseases.app.ui.guide.GuideFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
