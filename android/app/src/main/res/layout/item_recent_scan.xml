<?xml version="1.0" encoding="utf-8"?>
<!-- Recent-scans strip on the camera screen. Compact glass card. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="72dp"
    android:layout_marginEnd="@dimen/space_sm"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/glass_elevation_soft"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/space_md">

        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_disease_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:textSize="@dimen/text_body_sm"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            android:maxWidth="100dp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
