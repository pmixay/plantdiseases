<?xml version="1.0" encoding="utf-8"?>
<!--
    Community "second opinion" sheet. Opened from a low-confidence result
    (ask) or from a "near you" carousel cell (answer). Shows the running
    consensus + existing opinions, then a class picker + optional note to
    add your own. The host activity owns nothing — the sheet talks to the
    repository directly and reloads itself after a successful post.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_2xl">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/tv_opinion_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_opinion_title"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <TextView
            android:id="@+id/tv_opinion_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/community_opinion_subtitle"
            android:textSize="@dimen/text_body_sm"
            android:textColor="@color/on_surface_secondary" />

        <!-- The shared scan photo, framed like the scan-result screen's image
             card so the sheet reads like a real result. The CARD is shown/hidden
             programmatically; hidden when this scan has no thumbnail. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_opinion_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="@dimen/glass_stroke_width"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_opinion_photo"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="@string/community_opinion_photo_desc"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Current diagnosis block — styled like the scan-result status card
             (icon + ALLCAPS label + verdict + confidence/species line) so the
             sheet mirrors a real result. Set programmatically; hidden if
             unknown. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_opinion_current"
            style="@style/App.GlassCard.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_disease"
                    app:tint="@color/on_surface_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_opinion_diagnosis_label"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tv_opinion_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/on_surface"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Leaf Spot" />

                    <!-- Model's read: confidence only. The species belongs to
                         the species card below, not to this line. -->
                    <TextView
                        android:id="@+id/tv_opinion_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/on_surface_secondary"
                        android:visibility="gone"
                        tools:text="Confidence 87%"
                        tools:visibility="visible" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- The species this scan is of. Hidden when the upload carried no
             PlantNet binomial (CommunityScanItem.species is nullable — servers
             without a PlantNet key never populate it), so the card never
             becomes a dead-end tap. -->
        <com.plantdiseases.app.ui.common.SpeciesInfoCardView
            android:id="@+id/card_opinion_species"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone" />

        <!-- Owner-only request status: how long the ask stays visible and a
             "Stop request" action — reachable at any point, including after
             replies arrived (stopping ends further notifications). -->
        <LinearLayout
            android:id="@+id/ll_opinion_owner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_opinion_owner_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/on_surface_secondary"
                tools:text="Request open · 41 h left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_opinion_stop_request"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/second_opinion_stop"
                android:textColor="@color/disease_red" />

        </LinearLayout>

        <!-- Agree / Disagree vote (feedback-style). Agree confirms the model's
             diagnosis; Disagree reveals the picker to choose the real one.
             Hidden in view-only / already-voted modes. -->
        <LinearLayout
            android:id="@+id/ll_opinion_vote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_opinion_agree"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/community_opinion_agree"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_opinion_disagree"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textAllCaps="false"
                android:text="@string/community_opinion_disagree" />

        </LinearLayout>

        <!-- Running consensus vote graph (header + bars set programmatically). -->
        <TextView
            android:id="@+id/tv_opinion_votes_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/community_votes_header"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_opinion_graph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone" />

        <!-- Existing opinions, forum-style: one comment row per opinion
             (avatar + nickname + time + suggested class + optional note),
             added programmatically under a "Replies (N)" header. -->
        <TextView
            android:id="@+id/tv_opinion_list_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:visibility="gone"
            tools:text="Replies (3)" />

        <LinearLayout
            android:id="@+id/ll_opinion_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            android:id="@+id/tv_opinion_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/community_opinion_empty"
            android:textSize="@dimen/text_body_sm"
            android:textColor="@color/on_surface_secondary"
            android:visibility="gone" />

        <!-- Class picker -->
        <TextView
            android:id="@+id/tv_opinion_pick_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/community_opinion_pick_label"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_opinion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:singleSelection="true"
            app:selectionRequired="false"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:chipSpacingVertical="@dimen/space_xs" />

        <!-- Optional note -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_opinion_note"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/community_opinion_note_hint"
            app:boxCornerRadiusTopStart="@dimen/radius_md"
            app:boxCornerRadiusTopEnd="@dimen/radius_md"
            app:boxCornerRadiusBottomStart="@dimen/radius_md"
            app:boxCornerRadiusBottomEnd="@dimen/radius_md"
            app:counterEnabled="true"
            app:counterMaxLength="500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_opinion_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="2"
                android:maxLines="5" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_opinion_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_opinion_send"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_opinion_send"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
