<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The cover photo controls live in an overflow group rather than
         as toolbar icons because they're rare actions (touched on
         creation + the odd update). Set + Clear share the same slot;
         the UI doesn't try to grey out Clear when no cover is set
         because the action is harmless and the no-op feedback is
         cheap. -->
    <item
        android:id="@+id/action_set_cover_photo"
        android:title="@string/cover_photo_set"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_clear_cover_photo"
        android:title="@string/cover_photo_clear"
        app:showAsAction="never" />

    <!-- Destructive delete. Kept in the overflow (never as a toolbar
         icon) and behind a confirmation dialog — accidental deletes
         cascade-drop journal entries and reminders via the Room FK
         constraint. -->
    <item
        android:id="@+id/action_delete_plant"
        android:title="@string/delete_plant"
        app:showAsAction="never" />

</menu>
