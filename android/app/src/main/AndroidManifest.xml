<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Coarse location only: groups opted-in community scans by ~30 km area.
         Requested in-context when the user enables community. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".PlantDiseasesApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlantDiseases"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PlantDiseases.Splash"
            android:windowSoftInputMode="adjustResize">
            <!--
                No ``android:configChanges`` — we want the system to
                recreate MainActivity on uiMode (night-mode) and
                locale flips. Letting AppCompatDelegate do the
                recreate is the only reliable way to get the view
                tree to re-resolve themed attributes; intercepting
                via ``onConfigurationChanged`` leaves the layouts on
                the old colours and used to hang the app when the
                profile screen tried to compensate with a manual
                ``recreate()`` racing against AppCompat's own.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.pro.ProActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${RUSTORE_PAY_SCHEME}" />
            </intent-filter>
        </activity>

        <!-- The SDK dependencies remain compile-time available, but every
             provider component is disabled unless that provider's own mobile
             configuration is complete. This keeps Yandex and VK independent
             and closes unused exported redirect handlers. -->
        <activity
            android:name="com.yandex.authsdk.internal.AuthSdkActivity"
            android:enabled="${YANDEX_OAUTH_ENABLED}" />
        <activity
            android:name="com.yandex.authsdk.internal.ChromeTabLoginActivity"
            android:enabled="${YANDEX_OAUTH_ENABLED}" />
        <activity
            android:name="com.yandex.authsdk.internal.WebViewLoginActivity"
            android:enabled="${YANDEX_OAUTH_ENABLED}" />
        <activity
            android:name="com.yandex.authsdk.internal.ChromeTabDataActivity"
            android:enabled="${YANDEX_OAUTH_ENABLED}" />
        <activity-alias
            android:name="com.yandex.authsdk.YandexOauthClientIdActivity"
            android:enabled="${YANDEX_OAUTH_ENABLED}"
            android:targetActivity="com.yandex.authsdk.internal.ChromeTabDataActivity"
            tools:replace="android:enabled" />

        <activity
            android:name="com.vk.id.internal.auth.AuthActivity"
            android:enabled="${VKID_OAUTH_ENABLED}" />
        <activity
            android:name="com.vk.id.internal.auth.RedirectUriReceiverActivity"
            android:enabled="${VKID_OAUTH_ENABLED}" />
        <activity
            android:name="com.vk.id.captcha.web.VKCaptchaWebViewActivity"
            android:enabled="${VKID_OAUTH_ENABLED}" />

        <activity
            android:name=".ui.analysis.AnalysisActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|locale|layoutDirection|fontScale|density|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <!--
                Unlike MainActivity, this screen handles configuration
                changes itself instead of being recreated. Its only job is
                one paid server analysis plus the Room write of the scan
                the server issued an id for; a recreate (night mode,
                language, font scale, a multi-window resize, or rotation on
                a large screen, where Android 16 ignores the portrait lock)
                cancelled lifecycleScope mid-flight and onCreate started a
                second analysis, losing the first scan if the response had
                already landed. The cost is a few seconds on the old theme
                or language; the result screen it opens starts fresh.
            -->
        </activity>

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.PlantDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.RoomDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.care.CareCalendarActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.care.CareDayActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.care.CareTaskActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.PhotoViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.PhotoCompareActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.camera.LightMeterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.camera.WaterCalculatorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.community.CommunityMapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.community.forum.PostDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ui.community.forum.ComposePostActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ui.community.forum.ForumSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ui.community.forum.HelperProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.community.forum.ModerationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.community.forum.ModerationNoticesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.gallery.MyScansActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.legal.PrivacyPolicyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.symptom.SymptomCheckerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.identify.SpeciesIdentifyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.species.SpeciesDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.guide.GuideDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- The plant-care guide list (Home's tools grid). -->
        <activity
            android:name=".ui.guide.GuideActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Custom crop screen (our own CropActivity + CropImageView). Uses
             the standard app theme; the seamless background and floating
             control panel are done in the layout, not the theme. -->
        <activity
            android:name=".ui.crop.CropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PlantDiseases" />

        <receiver
            android:name=".worker.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.plantdiseases.action.REMINDER_DONE" />
                <action android:name="com.plantdiseases.action.REMINDER_SNOOZE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging. We initialise Firebase manually from
             BuildConfig.FCM_* (no google-services.json), so firebase-common's
             auto-init provider must never run — it would log a failure on
             every start because the FCM resources aren't present. It is
             declared disabled, which the system never instantiates, rather
             than stripped with tools:node="remove": AGP merges this file once
             without any library manifest when it builds the unit-test
             manifest, and a remove marker with nothing to remove warns there
             on every build. name, authorities and exported repeat the
             library's own values, so they merge with it; if Firebase ever
             changes them the merge fails loudly instead of drifting. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:enabled="false"
            android:exported="false" />

        <service
            android:name=".push.PlantMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Post FCM notifications on the existing community channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="community" />

        <!-- Public RuStore Console identifiers. The Pay content provider is
             disabled in unconfigured/recovery builds, so a blank local setup
             remains a normal supported state and never touches the SDK. -->
        <meta-data
            android:name="console_app_id_value"
            android:value="${RUSTORE_CONSOLE_APP_ID}" />
        <meta-data
            android:name="sdk_pay_scheme_value"
            android:value="${RUSTORE_PAY_SCHEME}" />

        <provider
            android:name="ru.rustore.sdk.pay.RuStorePayContentProvider"
            android:enabled="${RUSTORE_PAY_ENABLED}"
            tools:replace="android:enabled" />

    </application>
</manifest>
