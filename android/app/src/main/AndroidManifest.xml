<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Coarse location only: groups opted-in community scans by ~30 km area.
         Requested in-context when the user enables community. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Only needed to autosave snapped scan photos into the gallery on
         Android 9 and below (scoped storage on 10+ needs no permission for
         MediaStore inserts). Requested in-context when the user enables the
         "Autosave photos to album" toggle on a legacy device. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".PlantDiseasesApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlantDiseases"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PlantDiseases.Splash"
            android:windowSoftInputMode="adjustResize">
            <!--
                No ``android:configChanges`` — we want the system to
                recreate MainActivity on uiMode (night-mode) and
                locale flips. Letting AppCompatDelegate do the
                recreate is the only reliable way to get the view
                tree to re-resolve themed attributes; intercepting
                via ``onConfigurationChanged`` leaves the layouts on
                the old colours and used to hang the app when the
                profile screen tried to compensate with a manual
                ``recreate()`` racing against AppCompat's own.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.analysis.AnalysisActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.PlantDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.PhotoViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.garden.PhotoCompareActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.camera.LightMeterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.camera.WaterCalculatorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.community.NearbyScansActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.community.CommunityMapActivity"
            android:exported="false" />

        <activity
            android:name=".ui.symptom.SymptomCheckerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.identify.SpeciesIdentifyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.species.SpeciesDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.guide.GuideDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Re-declare the cropper activity (merged with the library's
             entry) purely to give it an action-bar theme styled with the
             app gradient. Without an action-bar theme its Done/cancel
             controls have nowhere to render. -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.PlantDiseases.Crop"
            tools:replace="android:exported" />

        <receiver
            android:name=".worker.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.plantdiseases.action.REMINDER_DONE" />
                <action android:name="com.plantdiseases.action.REMINDER_SNOOZE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging. We initialise Firebase manually from
             BuildConfig.FCM_* (no google-services.json), so the auto-init
             provider is removed — otherwise it logs a noisy failure when the
             FCM resources aren't present. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <service
            android:name=".push.PlantMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Post FCM notifications on the existing community channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="community" />

    </application>
</manifest>
