{
  "openapi": "3.1.0",
  "info": {
    "title": "PlantDiseases Stateless ML Worker",
    "version": "1.0.0-handoff"
  },
  "servers": [
    {
      "url": "https://ml-worker.private.invalid"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "worker_health",
        "responses": {
          "200": {
            "description": "Aggregate worker health only"
          }
        }
      }
    },
    "/v1/infer": {
      "post": {
        "operationId": "infer_sanitized_image",
        "security": [
          {
            "mutualTLS": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/InferenceRequest"
              },
              "encoding": {
                "image": {
                  "contentType": "image/jpeg"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnosis produced without persistent request state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid allowlisted request field or image"
          },
          "409": {
            "description": "One-use request ID was already consumed"
          },
          "413": {
            "description": "Encoded or decoded image limit exceeded"
          },
          "503": {
            "description": "Requested model is unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTLS": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "InferenceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "request_id",
          "model_family",
          "language",
          "result_options"
        ],
        "properties": {
          "image": {
            "type": "string",
            "format": "binary",
            "contentMediaType": "image/jpeg"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "model_family": {
            "type": "string",
            "enum": [
              "gamma",
              "frontier"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ]
          },
          "result_options": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "diagnosis",
                "regions",
                "top_k",
                "uncertainty"
              ]
            }
          }
        }
      },
      "InferenceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "result"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "type": "object",
            "description": "Versioned diagnosis payload returned to the Russian application API"
          }
        }
      }
    }
  }
}
