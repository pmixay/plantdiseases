# Copy to a host-only mode-0600 file. This starts an isolated real-provider
# account beta beside main; never commit the filled file.
COMPOSE_PROJECT_NAME=plantdisease_account_beta_german
BETA_VOLUME_PREFIX=plantdisease_account_beta_german

# Use branch-specific local tags when building on the VDS with
# compose.german-vds.build.yml. Replace the suffix with the deployed git SHA.
BETA_ACCOUNT_IMAGE=plantdiseases-account-beta-account-api:replace-with-git-sha
BETA_APP_IMAGE=plantdiseases-account-beta-app-api:replace-with-git-sha

# Generate a new random staging-only value; never reuse a production password.
BETA_POSTGRES_PASSWORD=replace-with-random-beta-password

# The account API and Android APK must use the same dedicated beta provider
# applications. VKID_CLIENT_SECRET is Android-only and does not belong here.
YANDEX_CLIENT_ID=replace-with-beta-yandex-client-id
VKID_CLIENT_ID=12345

# Mount the already-provisioned PlantVision bundle read-only. This may point at
# main's model directory because model artefacts are immutable; no main data,
# logs, cache, database, or media directory is shared.
BETA_MODELS_DIR=/absolute/path/to/plantvision-models

APP_API_PORT=18100
ACCOUNT_API_PORT=18101

# Use a dedicated non-conflicting bridge so the host-nginx peer address is
# stable and can be trusted exactly. Verify these values against the target
# host's existing Docker networks before first start. Never use '*'.
BETA_EDGE_SUBNET=172.30.251.0/28
BETA_EDGE_GATEWAY=172.30.251.1
BETA_FORWARDED_ALLOW_IPS=172.30.251.1
BETA_TRUSTED_PROXIES=172.30.251.1
